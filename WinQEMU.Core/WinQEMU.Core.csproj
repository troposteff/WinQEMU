<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WinQEMU.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Interface text: English in Text\X.resx, French in Text\X.fr.resx (see Text\UiLanguage.cs). Each English file
       becomes a class of its own (CommonText.Cancel…), so a key misspelled in code does not build. -->
  <ItemGroup>
    <EmbeddedResource Update="Text\CommonText.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="WinQEMU.Core.Text" StronglyTypedClassName="CommonText" StronglyTypedFileName="$(IntermediateOutputPath)CommonText.g.cs" PublicClass="true" />
    <EmbeddedResource Update="Text\CoreText.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="WinQEMU.Core.Text" StronglyTypedClassName="CoreText" StronglyTypedFileName="$(IntermediateOutputPath)CoreText.g.cs" PublicClass="true" />
    <EmbeddedResource Update="Text\PlatformText.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="WinQEMU.Core.Text" StronglyTypedClassName="PlatformText" StronglyTypedFileName="$(IntermediateOutputPath)PlatformText.g.cs" PublicClass="true" />
    <EmbeddedResource Update="Text\EncryptionText.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="WinQEMU.Core.Text" StronglyTypedClassName="EncryptionText" StronglyTypedFileName="$(IntermediateOutputPath)EncryptionText.g.cs" PublicClass="true" />
    <EmbeddedResource Update="Text\CliText.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="WinQEMU.Core.Text" StronglyTypedClassName="CliText" StronglyTypedFileName="$(IntermediateOutputPath)CliText.g.cs" PublicClass="true" />
  </ItemGroup>
</Project>
