<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinQEMU.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinQEMU">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!--
                Everything the creation wizard needs lives here rather than in the dialog's own
                Resources. A local ResourceDictionary on a ContentDialog stops its template from
                resolving the theme radii, which fall back to 0 and render the dialog square while
                an untouched dialog in the same app is correctly rounded.
            -->
            <x:Double x:Key="ContentDialogMaxWidth">860</x:Double>

            <!--
                The ContentDialog template reads this resource directly instead of template-binding
                BorderThickness, so setting BorderThickness="0" on a dialog does nothing. The wizard
                draws its own rounded panel, and without this the template's square hairline border
                stays visible around it. Dialogs keep their rounded background, just no hairline.
            -->
            <Thickness x:Key="ContentDialogBorderWidth">0</Thickness>

            <!--
                Glyph size for the toolbar buttons, which show icons alone (ToolbarIconButton). The stock 20 px
                of SymbolIcon was too big beside the labels they had; one resource keeps the rows consistent.
            -->
            <x:Double x:Key="IconFontSize">16</x:Double>

            <!--
                The toolbar's commands as icons, their name and what they do in the tooltip (MainWindow.NameInTooltips).
                With labels, the row ran under Réseaux virtuels and Paramètres on the user's 1920 x 1200 screen at
                150 % (1280 px for the window). Plain buttons rather than compact AppBarButtons: those keep the room
                of their hidden label under the icon, which then sat above the library's Nouvelle VM and Importer.
                Their background stays clear even disabled (brushes in MachineToolbar's resources).
            -->
            <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- A disk's actions in the Disques section, square beside its file name. -->
            <Style x:Key="DiskIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- The full-screen bar's commands, icons alone too. -->
            <Style x:Key="FullScreenIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:EnumLabelConverter x:Key="EnumLabel" />
            <local:EnumMatchVisibilityConverter x:Key="EnumMatchVisibility" />
            <local:DiskCapacityConverter x:Key="DiskCapacity" />

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
