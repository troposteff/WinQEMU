<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.CloneVmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    Closing="OnClosing"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <!-- Own chrome and own button row, for the reasons documented on the creation wizard. -->
    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Width="460" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource Hint}"
                    Text="Copie complète : chaque disque est recopié tel qu'il est maintenant, en une image autonome. Les instantanés ne sont pas repris. Le clone reçoit ses propres adresses MAC." />
            </StackPanel>

            <TextBox
                x:Name="NameBox"
                AutomationProperties.Name="Nom du clone"
                Header="Nom du clone"
                TextChanged="OnNameChanged" />

            <TextBlock
                x:Name="SizeText"
                Style="{StaticResource Hint}" />

            <TextBlock
                Style="{StaticResource Hint}"
                Text="Le système invité garde son identité : nom d'hôte, identifiant de machine, SID Windows. Changez-les dans le clone s'il doit partager un réseau avec l'original." />

            <StackPanel x:Name="ProgressPanel" Spacing="4" Visibility="Collapsed">
                <ProgressBar x:Name="CopyProgress" Maximum="1" />
                <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" />
            </StackPanel>

            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Grid Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="CancelButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="OnCancelClick"
                    Content="Annuler" />
                <Button
                    x:Name="CloneButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="OnCloneClick"
                    Content="Cloner"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</ContentDialog>
