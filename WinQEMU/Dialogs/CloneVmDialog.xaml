<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.CloneVmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:WinQEMU.Core.Text"
    xmlns:t="using:WinQEMU.Text"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    Closing="OnClosing"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <!-- Own chrome and own button row, for the reasons documented on the creation wizard. -->
    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Width="460" Spacing="12">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

            <TextBox
                x:Name="NameBox"
                AutomationProperties.Name="{x:Bind t:DialogText.CloneName}"
                Header="{x:Bind t:DialogText.CloneName}"
                TextChanged="OnNameChanged" />

            <!-- The two kinds differ in what they cost now and in what they forbid later, so each says
                 both at the moment of choosing. -->
            <StackPanel Spacing="4">
                <RadioButton
                    x:Name="FullCopyOption"
                    Checked="OnKindChanged"
                    Content="{x:Bind t:DialogText.CloneFullCopy}"
                    GroupName="CloneKind"
                    IsChecked="True" />
                <TextBlock
                    Margin="28,0,0,0"
                    Style="{StaticResource Hint}"
                    Text="{x:Bind t:DialogText.CloneFullCopyHint}" />
                <RadioButton
                    x:Name="LinkedOption"
                    Margin="0,4,0,0"
                    Checked="OnKindChanged"
                    Content="{x:Bind t:DialogText.CloneLinked}"
                    GroupName="CloneKind" />
                <TextBlock
                    Margin="28,0,0,0"
                    Style="{StaticResource Hint}"
                    Text="{x:Bind t:DialogText.CloneLinkedHint}" />
                <TextBlock
                    x:Name="LinkedUnavailableText"
                    Margin="28,0,0,0"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource Hint}"
                    Visibility="Collapsed" />
            </StackPanel>

            <TextBlock x:Name="SizeText" Style="{StaticResource Hint}" />

            <TextBlock
                Style="{StaticResource Hint}"
                Text="{x:Bind t:DialogText.CloneIdentityHint}" />

            <StackPanel x:Name="ProgressPanel" Spacing="4" Visibility="Collapsed">
                <ProgressBar x:Name="CopyProgress" Maximum="1" />
                <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" />
            </StackPanel>

            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Grid Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="CancelButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="OnCancelClick"
                    Content="{x:Bind ct:CommonText.Cancel}" />
                <Button
                    x:Name="CloneButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="OnCloneClick"
                    Content="{x:Bind t:DialogText.CloneButton}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</ContentDialog>
