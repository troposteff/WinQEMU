<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.ConvertDiskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:WinQEMU.Core.Text"
    xmlns:t="using:WinQEMU.Text"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Width="500" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="CurrentText" Style="{StaticResource Hint}" />
            </StackPanel>

            <ComboBox
                x:Name="FormatBox"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="{x:Bind t:DialogText.ConvertTargetFormat}"
                Header="{x:Bind t:DialogText.ConvertTargetFormat}"
                SelectionChanged="OnFormatChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <CheckBox
                x:Name="CompressBox"
                Content="{x:Bind t:DialogText.ConvertCompress}"
                IsEnabled="False" />

            <muxc:InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind t:DialogText.ConvertWarning}"
                Severity="Warning"
                Title="{x:Bind t:DialogText.GoodToKnow}" />

            <Grid Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="OnCancelClick"
                    Content="{x:Bind ct:CommonText.Cancel}" />
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="OnConfirmClick"
                    Content="{x:Bind t:DialogText.ConvertButton}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</ContentDialog>
