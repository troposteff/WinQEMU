<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.ExportVmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    Closing="OnClosing"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <!-- Own chrome and own button row, for the reasons documented on the creation wizard. -->
    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Width="500" Spacing="12">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

            <TextBlock
                Style="{StaticResource Hint}"
                Text="Un paquet OVA (OVF 1.0, disques VMDK compressés) que VMware Workstation, ESXi, VirtualBox et Proxmox savent importer. La machine est exportée dans son état actuel." />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="PathBox"
                    AutomationProperties.Name="Fichier OVA"
                    Header="Fichier OVA"
                    TextChanged="OnPathChanged" />
                <Button
                    x:Name="BrowseButton"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="OnBrowseClick"
                    Content="Parcourir…" />
            </Grid>

            <TextBlock x:Name="SizeText" Style="{StaticResource Hint}" />

            <ScrollViewer x:Name="NotesScroller" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NotesPanel" Spacing="6" />
            </ScrollViewer>

            <StackPanel x:Name="ProgressPanel" Spacing="4" Visibility="Collapsed">
                <ProgressBar x:Name="ExportProgress" Maximum="1" />
                <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" />
            </StackPanel>

            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Grid Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="CancelButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="OnCancelClick"
                    Content="Annuler" />
                <Button
                    x:Name="ExportButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="OnExportClick"
                    Content="Exporter"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</ContentDialog>
