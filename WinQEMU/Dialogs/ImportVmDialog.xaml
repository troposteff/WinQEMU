<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.ImportVmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    Closing="OnClosing"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <!-- Own chrome and own button row, for the reasons documented on the creation wizard. -->
    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel Width="520" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SourceText" Style="{StaticResource Hint}" />
            </StackPanel>

            <TextBox
                x:Name="NameBox"
                AutomationProperties.Name="Nom de la machine importée"
                Header="Nom"
                TextChanged="OnNameChanged" />

            <!-- What was read, as it will be created: the user confirms hardware they can see. -->
            <TextBlock x:Name="SummaryText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />

            <TextBlock
                Style="{StaticResource Hint}"
                Text="Les disques sont convertis en qcow2 dans un nouveau dossier de la bibliothèque : la machine d'origine n'est pas modifiée et reste utilisable dans son hyperviseur." />

            <ScrollViewer x:Name="NotesScroller" MaxHeight="180" Visibility="Collapsed">
                <StackPanel x:Name="NotesPanel" Spacing="6" />
            </ScrollViewer>

            <StackPanel x:Name="ProgressPanel" Spacing="4" Visibility="Collapsed">
                <ProgressBar x:Name="CopyProgress" Maximum="1" />
                <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" />
            </StackPanel>

            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Grid Margin="0,8,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="CancelButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="OnCancelClick"
                    Content="Annuler" />
                <Button
                    x:Name="ImportButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="OnImportClick"
                    Content="Importer"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</ContentDialog>
