<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.NewVmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:WinQEMU.Core.Text"
    xmlns:t="using:WinQEMU.Text"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinQEMU"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <!--
        The dialog draws none of its own chrome, and the panel below supplies it instead.

        Two reasons. ContentDialog lays its built-in buttons out in a fixed order (primary, secondary,
        close) that cannot produce Annuler / Précédent / Suivant. And this dialog's frame rendered with
        square corners no matter what — overriding OverlayCornerRadius locally and app-wide changed
        nothing, while a plain ContentDialog in the same app rounds correctly — so the frame is drawn
        here, where its radius is not up for debate.

        Converters, label styles and the widened ContentDialogMaxWidth live in App.xaml.
    -->
    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid Width="700" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!--
                Star, not a fixed 380. On a 150% display the window is about 545 logical pixels tall, and
                a fixed step area plus a tall advisory made the grid outgrow the dialog, so the rounded
                Border clipped the button row away. Everything that can grow now lives in one scrolling
                row that yields, and the buttons sit outside it so they cannot be pushed off again.
            -->
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title drawn here too, since the dialog's own title bar is part of the chrome we dropped. -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding StepTitle, Mode=OneWay}" />
            <TextBlock Style="{StaticResource Hint}" Text="{Binding StepCaption, Mode=OneWay}" />
        </StackPanel>
        <muxc:ProgressBar
            Grid.Row="1"
            Maximum="6"
            Value="{Binding StepIndex, Mode=OneWay}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <Grid>

                <!-- Step 1: identity -->
                <StackPanel Spacing="10" Visibility="{Binding IsStep1, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Bind ct:CommonText.Name}" />
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Bind t:DialogText.NewVmDescription}" />
                    <TextBox
                        Height="70"
                        AcceptsReturn="True"
                        Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="{x:Bind t:DialogText.NewVmLibraryFolder}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            IsReadOnly="True"
                            Text="{Binding LibraryRoot, Mode=OneWay}" />
                        <Button Grid.Column="1" Click="OnBrowseLibraryClick" Content="{x:Bind t:DialogText.Change}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="{x:Bind t:DialogText.NewVmTargetFolder}" />
                        <Run Text="{Binding TargetFolder, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- Step 2: guest OS -->
                <StackPanel Spacing="10" Visibility="{Binding IsStep2, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{x:Bind t:DialogText.NewVmOsHint}" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Bind t:DialogText.NewVmOperatingSystem}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" />

                    <Border Padding="12" Background="#11000000" CornerRadius="6">
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind t:DialogText.NewVmAppliedValues}" />
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="{x:Bind t:DialogText.NewVmArchitectureLabel}" />
                                <Run Text="{Binding SelectedProfile.Architecture, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="{x:Bind t:DialogText.NewVmFirmwareLabel}" />
                                <Run Text="{Binding Firmware, Mode=OneWay, Converter={StaticResource EnumLabel}}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="{x:Bind t:DialogText.NewVmDiskBusLabel}" />
                                <Run Text="{Binding DiskBus, Mode=OneWay, Converter={StaticResource EnumLabel}}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Step 3: platform -->
                <StackPanel Spacing="10" Visibility="{Binding IsStep3, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding HostSummary, Mode=OneWay}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Bind t:DialogText.VirtualProcessors}" />
                    <muxc:NumberBox
                        Maximum="64"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{Binding CpuCount, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Bind t:DialogText.MemoryMb}" />
                    <muxc:NumberBox
                        Maximum="1048576"
                        Minimum="128"
                        SmallChange="512"
                        SpinButtonPlacementMode="Inline"
                        Value="{Binding MemoryMb, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Bind t:DialogText.Firmware}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding FirmwareOptions}"
                        SelectedItem="{Binding Firmware, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox
                        Content="{x:Bind t:DialogText.NewVmRtcLocal}"
                        IsChecked="{Binding RtcLocalTime, Mode=TwoWay}" />
                </StackPanel>

                <!-- Step 4: disk -->
                <StackPanel Spacing="10" Visibility="{Binding IsStep4, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <RadioButton Content="{x:Bind t:DialogText.NewVmCreateDisk}" IsChecked="{Binding CreateNewDisk, Mode=TwoWay}" />

                    <StackPanel
                        Margin="28,0,0,0"
                        Spacing="10"
                        Visibility="{Binding CreateNewDisk, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Bind t:DialogText.NewVmDiskSize}" />
                        <muxc:NumberBox
                            Maximum="8192"
                            Minimum="1"
                            SmallChange="8"
                            SpinButtonPlacementMode="Inline"
                            Value="{Binding DiskSizeGb, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Format" />
                        <ComboBox
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding DiskFormatOptions}"
                            SelectedItem="{Binding DiskFormat, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{x:Bind t:DialogText.NewVmFormatHint}" />
                    </StackPanel>

                    <RadioButton Content="{x:Bind t:DialogText.NewVmExistingDisk}" IsChecked="{Binding UseExistingDisk, Mode=TwoWay}" />

                    <Grid
                        Margin="28,0,0,0"
                        ColumnSpacing="8"
                        Visibility="{Binding UseExistingDisk, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="{x:Bind t:DialogText.NewVmExistingDiskPlaceholder}"
                            Text="{Binding ExistingDiskPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Click="OnBrowseDiskClick" Content="{x:Bind ct:CommonText.Browse}" />
                    </Grid>

                    <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="Bus" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding DiskBusOptions}"
                        SelectedItem="{Binding DiskBus, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Step 5: media and network -->
                <StackPanel Spacing="10" Visibility="{Binding IsStep5, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Bind t:DialogText.NewVmIso}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="{x:Bind t:DialogText.NewVmNoIso}"
                            Text="{Binding IsoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Click="OnBrowseIsoClick" Content="{x:Bind ct:CommonText.Browse}" />
                    </Grid>
                    <CheckBox Content="{x:Bind t:DialogText.NewVmBootFromIso}" IsChecked="{Binding BootFromIso, Mode=TwoWay}" />

                    <!--
                        VMware's "installation simplifiée": Windows installs by itself, then its drivers and the
                        guest agent from the virtio-win drive. The password stays in the dialog and the answer
                        file, never in the descriptor.
                    -->
                    <StackPanel
                        Padding="12"
                        Background="#11000000"
                        CornerRadius="6"
                        Spacing="8"
                        Visibility="{Binding CanInstallUnattended, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="{x:Bind t:DialogText.NewVmUnattended}" IsChecked="{Binding Unattended, Mode=TwoWay}" />
                        <TextBlock
                            Style="{StaticResource Hint}"
                            Text="{Binding UnattendedHint, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <Grid
                            ColumnSpacing="8"
                            RowSpacing="6"
                            Visibility="{Binding UseUnattended, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                Header="{x:Bind t:DialogText.UserName}"
                                Text="{Binding UnattendedUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <PasswordBox
                                x:Name="UnattendedPasswordBox"
                                Grid.Column="1"
                                Header="{x:Bind t:DialogText.Password}"
                                PasswordChanged="OnUnattendedPasswordChanged" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource Hint}"
                            Visibility="{Binding UseUnattended, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="{x:Bind t:DialogText.NewVmComputerName}" />
                            <Run Text="{Binding UnattendedComputerName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="{x:Bind t:DialogText.NewVmSecondaryIso}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="virtio-win.iso"
                            Text="{Binding SecondaryIsoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Click="OnBrowseDriversClick" Content="{x:Bind ct:CommonText.Browse}" />
                    </Grid>

                    <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldLabel}" Text="{x:Bind t:DialogText.Network}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind t:DialogText.NetworkConnection}"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding NetworkChoices}"
                        SelectedValue="{Binding NetworkConnection, Mode=TwoWay}"
                        SelectedValuePath="Key" />
                </StackPanel>

                <!-- Step 6: summary -->
                <StackPanel Spacing="10" Visibility="{Binding IsStep6, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <Border Padding="12" Background="#11000000" CornerRadius="6">
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Text="{Binding Summary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Border>

                    <muxc:Expander HorizontalAlignment="Stretch" Header="{x:Bind t:DialogText.NewVmCommandLine}">
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="11"
                            IsTextSelectionEnabled="True"
                            Text="{Binding CommandPreview, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </muxc:Expander>
                </StackPanel>
            </Grid>

            <!-- Blocking errors and non-blocking advisories, inside the scroll with the step they concern -->
            <StackPanel Spacing="8">
                <muxc:InfoBar
                    IsClosable="False"
                    IsOpen="{Binding HasValidationMessage, Mode=OneWay}"
                    Message="{Binding ValidationMessage, Mode=OneWay}"
                    Severity="Error" />
                <muxc:InfoBar
                    IsClosable="False"
                    IsOpen="{Binding HasAdvisory, Mode=OneWay}"
                    Message="{Binding Advisory, Mode=OneWay}"
                    Severity="Warning"
                    Title="{x:Bind t:DialogText.GoodToKnow}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Annuler, Précédent, Suivant — left to right, as requested. -->
        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Click="OnCancelClick"
                Content="{x:Bind ct:CommonText.Cancel}" />

            <Button
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Click="OnBackClick"
                Content="{x:Bind t:DialogText.NewVmBack}"
                IsEnabled="{Binding CanGoBack, Mode=OneWay}" />

            <Button
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Click="OnNextClick"
                Content="{Binding PrimaryButtonText, Mode=OneWay}"
                IsEnabled="{Binding IsCurrentStepValid, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</ContentDialog>
