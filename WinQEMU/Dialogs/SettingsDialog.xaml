<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <!--
        Chrome is drawn below rather than by ContentDialog, for the same reason as the creation
        wizard: the built-in frame renders square corners here and the button order is fixed.
        Settings apply as they are changed, so the only button is Fermer.
    -->
    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid Width="680" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--
                    Star, not Auto: on a 150% display a 1440-pixel-tall window is only 545 logical
                    pixels, less than this content wants. Auto made the grid outgrow the dialog and the
                    rounded Border clipped the library section and the Fermer button away. Star lets the
                    scroller give up the height instead, and degrades to Auto if it is ever measured
                    unbounded.
                -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Paramètres" />
                <TextBlock Style="{StaticResource Hint}" Text="Les modifications prennent effet immédiatement." />
            </StackPanel>

            <ScrollViewer Grid.Row="1" MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <!--
                    A ContentControl rather than the StackPanel itself: IsEnabled lives on Control, and
                    disabling it during detection has to leave the ScrollViewer above still scrollable.
                -->
                <ContentControl x:Name="SettingsPanel" HorizontalContentAlignment="Stretch">
                <StackPanel Margin="0,4,0,0" Spacing="18">

                    <!-- QEMU installation -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Installation de QEMU" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="WinQEMU n'installe pas QEMU. Laissez la détection automatique faire le travail, ou indiquez le dossier contenant qemu-system-x86_64.exe et qemu-img.exe." />

                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding QemuDirectoryDisplay, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Dossier imposé dans les paramètres — la détection automatique est désactivée."
                                           Visibility="{Binding IsQemuDirectoryOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnBrowseQemuClick" Content="Choisir un dossier…" />
                            <Button
                                Click="OnResetQemuClick"
                                Content="Revenir à la détection automatique"
                                IsEnabled="{Binding IsQemuDirectoryOverridden, Mode=OneWay}" />
                            <Button Click="OnRedetectClick" Content="Relancer la détection" />
                            <muxc:ProgressRing
                                x:Name="BusyRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Margin="0,4,0,0" ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Hint}" Text="Version" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding QemuVersionDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Hint}" Text="Accélération" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccelerationDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Hint}" Text="Architectures" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ArchitecturesDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Hint}" Text="Micrologiciels" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FirmwareDisplay, Mode=OneWay}" TextWrapping="Wrap" />
                        </Grid>

                        <muxc:Expander
                            HorizontalAlignment="Stretch"
                            Header="Dossiers écartés pendant la détection"
                            Visibility="{Binding HasDiagnostics, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource Hint}"
                                Text="{Binding DiagnosticsText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </muxc:Expander>
                    </StackPanel>

                    <muxc:InfoBar
                        IsClosable="False"
                        IsOpen="{Binding IsQemuMissing, Mode=OneWay}"
                        Message="{Binding QemuStatusDetail, Mode=OneWay}"
                        Severity="Error"
                        Title="QEMU est introuvable" />

                    <!-- Start at the Windows logon -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Démarrage" />
                        <ToggleSwitch
                            x:Name="StartAtLogonSwitch"
                            Header="Lancer WinQEMU à l'ouverture de session Windows"
                            OffContent="Non"
                            OnContent="Oui"
                            Toggled="OnStartAtLogonToggled" />
                        <TextBlock
                            x:Name="StartAtLogonHint"
                            Style="{StaticResource Hint}"
                            Text="WinQEMU s'ouvre alors dans la zone de notification et démarre les machines marquées « Démarrer avec WinQEMU » (section Démarrage automatique de chaque machine). Windows le liste aussi dans ses applications de démarrage."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Sound -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Son des machines virtuelles" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="La sortie où toutes les machines jouent leur son. Windows ne la retient que pour le programme QEMU dans son ensemble : elle ne peut pas différer d'une machine à l'autre. Le volume et la coupure, eux, se règlent pour chaque machine par le bouton Son." />
                        <ComboBox
                            x:Name="AudioOutputBox"
                            MinWidth="320"
                            AutomationProperties.Name="Sortie audio des machines virtuelles"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Id"
                            SelectionChanged="OnAudioOutputChanged" />
                    </StackPanel>

                    <!-- VM library -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Bibliothèque de machines virtuelles" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Dossier analysé au démarrage et proposé par défaut à la création. Le changer relit la bibliothèque ; aucun fichier n'est déplacé et les machines du dossier précédent disparaissent simplement de la liste." />

                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontFamily="Consolas"
                                IsTextSelectionEnabled="True"
                                Text="{Binding LibraryRootDisplay, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnBrowseLibraryClick" Content="Choisir un dossier…" />
                            <Button Click="OnOpenLibraryClick" Content="Ouvrir dans l'Explorateur" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </ContentControl>
            </ScrollViewer>

            <Button
                Grid.Row="2"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                MinWidth="120"
                Click="OnCloseClick"
                Content="Fermer"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Border>
</ContentDialog>
