<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="using:WinQEMU.Core.Text"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:t="using:WinQEMU.Text"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <!--
        Chrome is drawn below rather than by ContentDialog, for the same reason as the creation
        wizard: the built-in frame renders square corners here and the button order is fixed.
        Settings apply as they are changed, so the only button is Fermer.
    -->
    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid Width="680" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--
                    Star, not Auto: on a 150% display a 1440-pixel-tall window is only 545 logical
                    pixels, less than this content wants. Auto made the grid outgrow the dialog and the
                    rounded Border clipped the library section and the Fermer button away. Star lets the
                    scroller give up the height instead, and degrades to Auto if it is ever measured
                    unbounded.
                -->
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ct:CommonText.Settings}" />
                <TextBlock Style="{StaticResource Hint}" Text="{x:Bind t:DialogText.SettingsSubtitle}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <!--
                    A ContentControl rather than the StackPanel itself: IsEnabled lives on Control, and
                    disabling it during detection has to leave the ScrollViewer above still scrollable.
                -->
                <ContentControl x:Name="SettingsPanel" HorizontalContentAlignment="Stretch">
                <StackPanel Margin="0,4,0,0" Spacing="18">

                    <!-- QEMU installation -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:DialogText.SettingsQemu}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{x:Bind t:DialogText.SettingsQemuHint}" />

                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding QemuDirectoryDisplay, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{x:Bind t:DialogText.SettingsQemuOverridden}"
                                           Visibility="{Binding IsQemuDirectoryOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnBrowseQemuClick" Content="{x:Bind t:DialogText.ChooseFolder}" />
                            <Button
                                Click="OnResetQemuClick"
                                Content="{x:Bind t:DialogText.SettingsQemuReset}"
                                IsEnabled="{Binding IsQemuDirectoryOverridden, Mode=OneWay}" />
                            <Button Click="OnRedetectClick" Content="{x:Bind t:DialogText.SettingsQemuRedetect}" />
                            <muxc:ProgressRing
                                x:Name="BusyRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid Margin="0,4,0,0" ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Hint}" Text="Version" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding QemuVersionDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Hint}" Text="{x:Bind t:DialogText.SettingsAcceleration}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AccelerationDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Hint}" Text="Architectures" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ArchitecturesDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Hint}" Text="{x:Bind t:DialogText.SettingsFirmwares}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FirmwareDisplay, Mode=OneWay}" TextWrapping="Wrap" />
                        </Grid>

                        <muxc:Expander
                            HorizontalAlignment="Stretch"
                            Header="{x:Bind t:DialogText.SettingsDiagnostics}"
                            Visibility="{Binding HasDiagnostics, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                IsTextSelectionEnabled="True"
                                Style="{StaticResource Hint}"
                                Text="{Binding DiagnosticsText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </muxc:Expander>

                        <!-- Where QEMU is described, so the name is not read as the QEMU project's own: its mark. -->
                        <TextBlock IsTextSelectionEnabled="True"
                                   Style="{StaticResource Hint}"
                                   Text="{Binding AppVersionText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{x:Bind t:DialogText.SettingsQemuTrademark}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <muxc:InfoBar
                        IsClosable="False"
                        IsOpen="{Binding IsQemuMissing, Mode=OneWay}"
                        Message="{Binding QemuStatusDetail, Mode=OneWay}"
                        Severity="Error"
                        Title="{x:Bind t:DialogText.SettingsQemuMissing}" />

                    <!-- Start at the Windows logon -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:DialogText.SettingsStartup}" />
                        <ToggleSwitch
                            x:Name="StartAtLogonSwitch"
                            Header="{x:Bind t:DialogText.SettingsStartAtLogon}"
                            OffContent="{x:Bind ct:CommonText.No}"
                            OnContent="{x:Bind ct:CommonText.Yes}"
                            Toggled="OnStartAtLogonToggled" />
                        <TextBlock
                            x:Name="StartAtLogonHint"
                            Style="{StaticResource Hint}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Theme -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:DialogText.SettingsTheme}" />
                        <ComboBox
                            x:Name="ThemeBox"
                            MinWidth="320"
                            AutomationProperties.Name="{x:Bind t:DialogText.SettingsTheme}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Code"
                            SelectionChanged="OnThemeChanged" />
                    </StackPanel>

                    <!-- Language -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:DialogText.SettingsLanguage}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Bind t:DialogText.SettingsLanguageHint}" TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="LanguageBox"
                            MinWidth="320"
                            AutomationProperties.Name="{x:Bind t:DialogText.SettingsLanguage}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Code"
                            SelectionChanged="OnLanguageChanged" />
                    </StackPanel>

                    <!-- Sound -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:DialogText.SettingsSound}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{x:Bind t:DialogText.SettingsSoundHint}" />
                        <ComboBox
                            x:Name="AudioOutputBox"
                            MinWidth="320"
                            AutomationProperties.Name="{x:Bind t:DialogText.SettingsSoundOutput}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Id"
                            SelectionChanged="OnAudioOutputChanged" />
                    </StackPanel>

                    <!-- VM library -->
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:DialogText.SettingsLibrary}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="{x:Bind t:DialogText.SettingsLibraryHint}" />

                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontFamily="Consolas"
                                IsTextSelectionEnabled="True"
                                Text="{Binding LibraryRootDisplay, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnBrowseLibraryClick" Content="{x:Bind t:DialogText.ChooseFolder}" />
                            <Button Click="OnOpenLibraryClick" Content="{x:Bind t:DialogText.OpenInExplorer}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                </ContentControl>
            </ScrollViewer>

            <Button
                Grid.Row="2"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                MinWidth="120"
                Click="OnCloseClick"
                Content="{x:Bind ct:CommonText.Close}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Border>
</ContentDialog>
