<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.VirtualNetworksDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    Closing="OnClosing"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <!--
        Own chrome, as the other dialogs. Changes apply as they are made, like the settings: a network
        renamed here is renamed in every machine's card at once, since cards refer to it by id.
    -->
    <!--
        PointerPressed: a click on nothing in particular hands focus to the list (a tab stop), so the
        field being edited lets go — and commits, since its binding updates on losing focus. Buttons,
        fields and lists handle their own clicks, which never reach here.
    -->
    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        PointerPressed="OnBackgroundPressed">
        <Grid Width="640" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Réseaux virtuels" />
                <TextBlock
                    Style="{StaticResource Hint}"
                    Text="Des réseaux sur lesquels brancher les cartes des machines (Matériel, section Réseau, liste « Connexion »). WinQEMU les fait fonctionner lui-même ; sur un réseau privé ou interne, son serveur DHCP donne une adresse aux machines, sur un réseau externe c'est la box. Chaque réseau a son propre sous-réseau."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer
                x:Name="NetworkScroller"
                Grid.Row="1"
                MaxHeight="380"
                IsTabStop="True"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="EmptyText"
                        Style="{StaticResource Hint}"
                        Text="Aucun réseau pour l'instant." />
                    <ItemsControl x:Name="NetworkList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    Background="#11000000"
                                    CornerRadius="6">
                                    <Grid ColumnSpacing="8" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox
                                            Grid.Row="0" Grid.Column="0"
                                            AutomationProperties.Name="Nom du réseau"
                                            LostFocus="OnNameLostFocus"
                                            Text="{Binding Name, Mode=TwoWay}" />
                                        <Button
                                            Grid.Row="0" Grid.Column="1"
                                            Click="OnDeleteClick"
                                            Content="Supprimer"
                                            Tag="{Binding}" />
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding TypeText}" />
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Text="{Binding SubnetText}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Row="1" Grid.Column="1"
                                            Visibility="{Binding HasAddresses, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="Serveur DHCP"
                                            IsOn="{Binding Dhcp, Mode=TwoWay}"
                                            OffContent="DHCP"
                                            OnContent="DHCP"
                                            Toggled="OnDhcpToggled" />
                                        <!--
                                            Addresses are edited in place and take effect when the network's
                                            switch next starts. Text boxes update on losing focus, which is
                                            also when the settings are saved and the result checked.
                                        -->
                                        <!-- An external network's addresses are the physical network's: only its card is chosen here. -->
                                        <StackPanel
                                            Grid.Row="2" Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="{Binding Type, Mode=OneWay, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=External}">
                                            <TextBlock Width="110" VerticalAlignment="Center" Text="Carte" />
                                            <ComboBox
                                                Width="360"
                                                AutomationProperties.Name="Carte réseau de ce PC"
                                                Loaded="OnAdapterBoxLoaded"
                                                SelectionChanged="OnAdapterChanged" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Row="2" Grid.ColumnSpan="2"
                                            Spacing="6"
                                            Visibility="{Binding HasAddresses, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Width="110" VerticalAlignment="Center" Text="Sous-réseau" />
                                                <TextBox
                                                    Width="150"
                                                    AutomationProperties.Name="Adresse du sous-réseau"
                                                    LostFocus="OnAddressLostFocus"
                                                    Text="{Binding Subnet, Mode=TwoWay}" />
                                                <ComboBox
                                                    Width="200"
                                                    AutomationProperties.Name="Masque du sous-réseau"
                                                    Loaded="OnMaskBoxLoaded"
                                                    SelectionChanged="OnMaskChanged" />
                                            </StackPanel>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{Binding Dhcp, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Width="110" VerticalAlignment="Center" Text="DHCP, de" />
                                                <TextBox
                                                    Width="150"
                                                    AutomationProperties.Name="Première adresse distribuée"
                                                    LostFocus="OnAddressLostFocus"
                                                    PlaceholderText="{Binding DefaultDhcpStart, Mode=OneWay}"
                                                    Text="{Binding DhcpStart, Mode=TwoWay}" />
                                                <TextBlock VerticalAlignment="Center" Text="à" />
                                                <TextBox
                                                    Width="150"
                                                    AutomationProperties.Name="Dernière adresse distribuée"
                                                    LostFocus="OnAddressLostFocus"
                                                    PlaceholderText="{Binding DefaultDhcpEnd, Mode=OneWay}"
                                                    Text="{Binding DhcpEnd, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="6">
                <!-- Not IsEnabled: that is declared by Control, and a panel binding it breaks XamlCompiler. -->
                <StackPanel x:Name="AddButtons" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnAddPrivateClick" Content="Ajouter un réseau privé" />
                    <Button Click="OnAddInternalClick" Content="Ajouter un réseau interne" />
                    <Button Click="OnAddExternalClick" Content="Ajouter un réseau externe" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource Hint}"
                    Text="Un réseau interne relie aussi ce PC aux machines, par une carte TAP-Windows : une carte par réseau interne. Le pilote (d'OpenVPN, licence GPLv2, source github.com/OpenVPN/tap-windows6) est fourni avec WinQEMU et installé au premier réseau interne. Un réseau externe met les machines sur le réseau de ce PC, chacune avec sa propre adresse donnée par la box, grâce à Npcap ; elles n'y joignent pas ce PC lui-même (pour cela : leur carte NAT, ou un réseau interne)."
                    TextWrapping="Wrap" />
                <!-- Npcap's licence forbids bundling it: the user installs it, guided from here. -->
                <StackPanel x:Name="NpcapPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock
                        Text="Un réseau externe passe par Npcap, le pilote de capture de Wireshark, gratuit. Installez-le avec ses options par défaut, sans cocher « Restrict Npcap driver's access to Administrators only », puis cliquez à nouveau sur « Ajouter un réseau externe »."
                        TextWrapping="Wrap" />
                    <HyperlinkButton Padding="0" Content="Télécharger Npcap sur npcap.com" NavigateUri="https://npcap.com/#download" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="ProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ProgressText"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <Button
                Grid.Row="3"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Click="OnCloseClick"
                Content="Fermer"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Border>
</ContentDialog>
