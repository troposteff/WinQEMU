<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.VirtualNetworksDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinQEMU.Core.Models"
    xmlns:ct="using:WinQEMU.Core.Text"
    xmlns:t="using:WinQEMU.Text"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    Closing="OnClosing"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <!--
        Own chrome, as the other dialogs. Changes apply as they are made, like the settings: a network
        renamed here is renamed in every machine's card at once, since cards refer to it by id.
    -->
    <!--
        PointerPressed: a click on nothing in particular hands focus to the list (a tab stop), so the
        field being edited lets go — and commits, since its binding updates on losing focus. Buttons,
        fields and lists handle their own clicks, which never reach here.
    -->
    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        PointerPressed="OnBackgroundPressed">
        <Grid Width="640" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind t:DialogText.NetworksTitle}" />
                <TextBlock
                    Style="{StaticResource Hint}"
                    Text="{x:Bind t:DialogText.NetworksIntro}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer
                x:Name="NetworkScroller"
                Grid.Row="1"
                MaxHeight="380"
                IsTabStop="True"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="EmptyText"
                        Style="{StaticResource Hint}"
                        Text="{x:Bind t:DialogText.NetworksEmpty}" />
                    <ItemsControl x:Name="NetworkList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:VirtualNetwork">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    Background="#11000000"
                                    CornerRadius="6">
                                    <Grid ColumnSpacing="8" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox
                                            Grid.Row="0" Grid.Column="0"
                                            AutomationProperties.Name="{x:Bind t:DialogText.NetworksName}"
                                            LostFocus="OnNameLostFocus"
                                            Text="{Binding Name, Mode=TwoWay}" />
                                        <Button
                                            Grid.Row="0" Grid.Column="1"
                                            Click="OnDeleteClick"
                                            Content="{x:Bind ct:CommonText.Delete}"
                                            Tag="{Binding}" />
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding TypeText}" />
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Text="{Binding SubnetText}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Row="1" Grid.Column="1"
                                            Visibility="{Binding HasAddresses, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            AutomationProperties.Name="{x:Bind t:DialogText.NetworksDhcpServer}"
                                            IsOn="{Binding Dhcp, Mode=TwoWay}"
                                            OffContent="DHCP"
                                            OnContent="DHCP"
                                            Toggled="OnDhcpToggled" />
                                        <!--
                                            Addresses are edited in place and take effect when the network's
                                            switch next starts. Text boxes update on losing focus, which is
                                            also when the settings are saved and the result checked.
                                        -->
                                        <!-- An external network's addresses are the physical network's: only its card is chosen here. -->
                                        <StackPanel
                                            Grid.Row="2" Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Visibility="{Binding Type, Mode=OneWay, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=External}">
                                            <TextBlock Width="110" VerticalAlignment="Center" Text="{x:Bind t:DialogText.NetworksAdapter}" />
                                            <ComboBox
                                                Width="360"
                                                AutomationProperties.Name="{x:Bind t:DialogText.NetworksAdapterName}"
                                                Loaded="OnAdapterBoxLoaded"
                                                SelectionChanged="OnAdapterChanged" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Row="2" Grid.ColumnSpan="2"
                                            Spacing="6"
                                            Visibility="{Binding HasAddresses, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Width="110" VerticalAlignment="Center" Text="{x:Bind t:DialogText.NetworksSubnet}" />
                                                <TextBox
                                                    Width="150"
                                                    AutomationProperties.Name="{x:Bind t:DialogText.NetworksSubnetAddress}"
                                                    LostFocus="OnAddressLostFocus"
                                                    Text="{Binding Subnet, Mode=TwoWay}" />
                                                <ComboBox
                                                    Width="200"
                                                    AutomationProperties.Name="{x:Bind t:DialogText.NetworksSubnetMask}"
                                                    Loaded="OnMaskBoxLoaded"
                                                    SelectionChanged="OnMaskChanged" />
                                            </StackPanel>
                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                Visibility="{Binding Dhcp, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Width="110" VerticalAlignment="Center" Text="{x:Bind t:DialogText.NetworksDhcpFrom}" />
                                                <TextBox
                                                    Width="150"
                                                    AutomationProperties.Name="{x:Bind t:DialogText.NetworksDhcpFirst}"
                                                    LostFocus="OnAddressLostFocus"
                                                    PlaceholderText="{Binding DefaultDhcpStart, Mode=OneWay}"
                                                    Text="{Binding DhcpStart, Mode=TwoWay}" />
                                                <TextBlock VerticalAlignment="Center" Text="{x:Bind t:DialogText.NetworksDhcpTo}" />
                                                <TextBox
                                                    Width="150"
                                                    AutomationProperties.Name="{x:Bind t:DialogText.NetworksDhcpLast}"
                                                    LostFocus="OnAddressLostFocus"
                                                    PlaceholderText="{Binding DefaultDhcpEnd, Mode=OneWay}"
                                                    Text="{Binding DhcpEnd, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="6">
                <!-- Not IsEnabled: that is declared by Control, and a panel binding it breaks XamlCompiler. -->
                <StackPanel x:Name="AddButtons" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnAddPrivateClick" Content="{x:Bind t:DialogText.NetworksAddPrivate}" />
                    <Button Click="OnAddInternalClick" Content="{x:Bind t:DialogText.NetworksAddInternal}" />
                    <Button Click="OnAddExternalClick" Content="{x:Bind t:DialogText.NetworksAddExternal}" />
                </StackPanel>
                <TextBlock
                    Style="{StaticResource Hint}"
                    Text="{x:Bind t:DialogText.NetworksTypesHint}"
                    TextWrapping="Wrap" />
                <!-- Npcap's licence forbids bundling it: the user installs it, guided from here. -->
                <StackPanel x:Name="NpcapPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock
                        Text="{x:Bind t:DialogText.NetworksNpcapHint}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton Padding="0" Content="{x:Bind t:DialogText.NetworksNpcapDownload}" NavigateUri="https://npcap.com/#download" />
                </StackPanel>
                <!-- The Microsoft Store build carries no driver installer (TapDriver.IsBundled): the user installs TAP-Windows. -->
                <StackPanel x:Name="TapPanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock
                        Text="{x:Bind t:DialogText.NetworksTapHint}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton x:Name="TapDownloadLink" Padding="0" Content="{x:Bind t:DialogText.NetworksTapDownload}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="ProgressRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ProgressText"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <Button
                Grid.Row="3"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Click="OnCloseClick"
                Content="{x:Bind ct:CommonText.Close}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Border>
</ContentDialog>
