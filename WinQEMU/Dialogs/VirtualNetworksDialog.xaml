<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinQEMU.Dialogs.VirtualNetworksDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    BorderThickness="0"
    KeyDown="OnDialogKeyDown"
    Padding="0">

    <!--
        Own chrome, as the other dialogs. Changes apply as they are made, like the settings: a network
        renamed here is renamed in every machine's card at once, since cards refer to it by id.
    -->
    <Border
        Padding="24"
        Background="{ThemeResource ContentDialogBackground}"
        BorderBrush="{ThemeResource ContentDialogBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid Width="640" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Réseaux virtuels" />
                <TextBlock
                    Style="{StaticResource Hint}"
                    Text="Des réseaux sur lesquels brancher les cartes des machines (Matériel, section Réseau, mode « Réseau virtuel »). WinQEMU les fait fonctionner lui-même, avec un serveur DHCP : les machines y obtiennent une adresse toutes seules."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="EmptyText"
                        Style="{StaticResource Hint}"
                        Text="Aucun réseau pour l'instant." />
                    <ItemsControl x:Name="NetworkList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="10"
                                    Background="#11000000"
                                    CornerRadius="6">
                                    <Grid ColumnSpacing="8" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBox
                                            Grid.Row="0" Grid.Column="0"
                                            AutomationProperties.Name="Nom du réseau"
                                            LostFocus="OnNameLostFocus"
                                            Text="{Binding Name, Mode=TwoWay}" />
                                        <Button
                                            Grid.Row="0" Grid.Column="1"
                                            Click="OnDeleteClick"
                                            Content="Supprimer"
                                            Tag="{Binding}" />
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding TypeText}" />
                                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Text="{Binding SubnetText}" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Row="1" Grid.Column="1"
                                            AutomationProperties.Name="Serveur DHCP"
                                            IsOn="{Binding Dhcp, Mode=TwoWay}"
                                            OffContent="DHCP"
                                            OnContent="DHCP"
                                            Toggled="OnDhcpToggled" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="6">
                <Button Click="OnAddPrivateClick" Content="Ajouter un réseau privé" />
                <TextBlock
                    Style="{StaticResource Hint}"
                    Text="Interne (les machines et ce PC) et Externe (le réseau physique) demandent un pilote réseau sur Windows ; ils viendront ensuite."
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="ErrorText"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <Button
                Grid.Row="3"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                Click="OnCloseClick"
                Content="Fermer"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Border>
</ContentDialog>
