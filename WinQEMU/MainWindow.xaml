<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinQEMU.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WinQEMU.ViewModels"
    xmlns:models="using:WinQEMU.Core.Models"
    xmlns:controls="using:WinQEMU.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinQEMU"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:t="using:WinQEMU.Text"
    xmlns:ct="using:WinQEMU.Core.Text"
    mc:Ignorable="d"
    Title="WinQEMU">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        KeyboardAcceleratorPlacementMode="Hidden": by default WinUI shows an element's accelerator as a
        tooltip. Owned by the root grid, the F11 accelerator became a stray "F11" tooltip over anything
        without a tooltip of its own — the Start button, for one.
    -->
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden">
        <!-- The way out of full screen has to work whatever holds the focus, so it is an accelerator on
             the window as well as a key the console host keeps for itself. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="OnFullScreenAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The narrow/wide layout switch is applied in code-behind rather than through AdaptiveTrigger:
            its MinWindowWidth did not fire at the expected threshold, and comparing ActualWidth removes
            any doubt about which unit is being measured. See MainWindow.ApplyAdaptiveLayout.
        -->

        <!-- Environment and error notifications -->
        <!-- No top margin of its own: the empty panel left a 12-pixel band, plus the spacing of its closed bars,
             between the title bar and the library; an open bar brings its own (InfoBar Margin). -->
        <StackPanel x:Name="NotificationsPanel" Grid.Row="0" Margin="12,0,12,0" Spacing="8">
            <muxc:InfoBar
                Margin="0,12,0,0"
                IsOpen="{Binding IsQemuMissing, Mode=OneWay}"
                Visibility="{Binding IsQemuMissing, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                IsClosable="False"
                Severity="Error"
                Title="{x:Bind t:WindowText.NotifyQemuMissing}"
                Message="{Binding QemuStatusText, Mode=OneWay}">
                <muxc:InfoBar.ActionButton>
                    <HyperlinkButton Click="OnReadinessClick" Content="{x:Bind t:WindowText.NotifyQemuSetup}" />
                </muxc:InfoBar.ActionButton>
                <muxc:InfoBar.Content>
                    <TextBlock
                        Margin="0,0,0,12"
                        IsTextSelectionEnabled="True"
                        Text="{Binding QemuStatusDetail, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </muxc:InfoBar.Content>
            </muxc:InfoBar>

            <muxc:InfoBar
                CloseButtonClick="OnDismissErrorClick"
                Margin="0,12,0,0"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Severity="Warning"
                Title="{x:Bind t:WindowText.NotifyOperationFailed}"
                Message="{Binding ErrorMessage, Mode=OneWay}" />

            <muxc:InfoBar
                CloseButtonClick="OnDismissSettingsImportedClick"
                Margin="0,12,0,0"
                IsOpen="{Binding SettingsImported, Mode=OneWay}"
                Visibility="{Binding SettingsImported, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                Severity="Informational"
                Title="{x:Bind t:WindowText.NotifySettingsImported}"
                Message="{x:Bind t:WindowText.NotifySettingsImportedDetail}" />
        </StackPanel>

        <!--
            One grid for both columns, so the bands line up. Each column used to declare its own rows:
            the sidebar header sat 18 px below the toolbar, the search box 24 px above the tab strip, and
            the two content areas started at different heights. Sharing the row definitions makes the
            alignment structural instead of a set of hand-tuned margins.

            Row 0 header  · Row 1 sub-header · Row 2 content · Row 3 footer (left column only)
        -->
        <Grid x:Name="ShellGrid" Grid.Row="1" Padding="12,8,12,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- At least 64 px: the toolbar's plain buttons (40 px) left the search box and the state line
                     pressed against it, where the labelled AppBarButtons used to give the row its height. -->
                <RowDefinition x:Name="HeaderRow" Height="Auto" MinHeight="64" />
                <RowDefinition x:Name="SubHeaderRow" Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="FooterRow" Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Inventory header, centred on the taller command bar opposite it -->
            <Grid Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{x:Bind t:WindowText.LibraryTitle}"
                    TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="NewVmButton"
                            Width="36" Height="36" Padding="0"
                            AutomationProperties.Name="{x:Bind t:WindowText.LibraryNewVm}"
                            Click="OnNewVmClick"
                            IsEnabled="{Binding IsQemuAvailable, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind t:WindowText.LibraryNewVm}">
                            <muxc:SymbolIcon Symbol="Add" />
                        </Button>
                        <Button
                            Width="36" Height="36" Padding="0"
                            AutomationProperties.Name="{x:Bind t:WindowText.LibraryImportVm}"
                            Click="OnImportVmClick"
                            IsEnabled="{Binding IsQemuAvailable, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind t:WindowText.LibraryImportVmTip}">
                            <FontIcon FontSize="16" Glyph="&#xE896;" />
                        </Button>
                        <Button
                            x:Name="RefreshButton"
                            Width="36" Height="36" Padding="0"
                            AutomationProperties.Name="{x:Bind t:WindowText.LibraryRefresh}"
                            Command="{Binding RefreshCommand}"
                            ToolTipService.ToolTip="{x:Bind t:WindowText.LibraryRefreshTip}">
                            <muxc:SymbolIcon Symbol="Refresh" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBox
                    x:Name="VmSearchBox"
                    Grid.Row="1" Grid.Column="0"
                    Margin="0,0,76,8"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind t:WindowText.LibrarySearchName}"
                    PlaceholderText="{x:Bind t:WindowText.LibrarySearchPlaceholder}"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Beside the search box rather than in the header: there, a fourth button trimmed the
                     library's title to a few letters in the narrow layout (240 px). -->
                <StackPanel
                    Grid.Row="1" Grid.Column="0"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Width="34" Height="32" Padding="0"
                        AutomationProperties.Name="{x:Bind t:LibraryText.SortTip}"
                        Click="OnSortClick"
                        ToolTipService.ToolTip="{x:Bind t:LibraryText.SortTip}">
                        <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                    </Button>
                    <Button
                        Width="34" Height="32" Padding="0"
                        AutomationProperties.Name="{x:Bind t:LibraryText.NewFolder}"
                        Click="OnNewFolderClick"
                        ToolTipService.ToolTip="{x:Bind t:LibraryText.NewFolderTip}">
                        <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                    </Button>
                </StackPanel>

                <Grid Grid.Row="2" Grid.Column="0">
                    <Grid.Resources>
                        <DataTemplate x:Key="LibraryFolderTemplate">
                            <!-- Chevron, folder, name, and what it holds. The chevron's Tag is how a tap on it is told
                                 from a tap on the rest of the line (MainWindow.LineOf). -->
                            <Grid
                                Margin="0,6"
                                Padding="{Binding Indent}"
                                AutomationProperties.Name="{Binding AutomationName}"
                                ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="20" Height="20"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Tag="Chevron">
                                    <FontIcon FontSize="10" Glyph="{Binding ChevronGlyph}" />
                                </Border>
                                <FontIcon
                                    Grid.Column="1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Glyph="{Binding FolderGlyph}" />
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Opacity="0.6"
                                        Text="{Binding Summary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>

                        <DataTemplate x:Key="LibraryMachineTemplate">
                                <!-- Status dot first: which machines are running is the question the
                                     inventory has to answer at a glance. -->
                                <Grid
                                    Margin="0,6"
                                    Padding="{Binding Indent}"
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse
                                        Grid.Column="0"
                                        Width="10" Height="10"
                                        VerticalAlignment="Center"
                                        Fill="{Binding StateBrush}" />

                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.6"
                                            Text="{Binding StateText}"
                                            TextTrimming="CharacterEllipsis" />
                                        <!-- While searching: the folders the match is in. -->
                                        <TextBlock
                                            FontSize="12"
                                            Opacity="0.6"
                                            Text="{Binding Location}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                        </DataTemplate>

                        <controls:LibraryRowTemplateSelector
                            x:Key="LibraryRowTemplates"
                            FolderTemplate="{StaticResource LibraryFolderTemplate}"
                            MachineTemplate="{StaticResource LibraryMachineTemplate}" />
                    </Grid.Resources>

                    <!-- Folders and machines as one flattened tree: see Controls.LibraryListView for why not a TreeView. -->
                    <controls:LibraryListView
                        x:Name="VmList"
                        AllowDrop="True"
                        CanDragItems="True"
                        ContextRequested="OnLibraryContextRequested"
                        DragItemsCompleted="OnLibraryDragCompleted"
                        DragItemsStarting="OnLibraryDragStarting"
                        DragOver="OnLibraryDragOver"
                        Drop="OnLibraryDrop"
                        ItemTemplateSelector="{StaticResource LibraryRowTemplates}"
                        ItemsSource="{Binding Rows}"
                        Loaded="OnLibraryListLoaded"
                        PreviewKeyDown="OnLibraryKeyDown"
                        SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                        SelectionMode="Single" />

                    <!-- Empty states, so a blank panel is never left unexplained. -->
                    <TextBlock
                        Margin="8,24,8,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Opacity="0.6"
                        Text="{x:Bind t:WindowText.LibraryEmpty}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding ShowsLibraryEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Margin="8,24,8,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Opacity="0.6"
                        Text="{x:Bind t:WindowText.LibraryNoResults}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasNoSearchResults, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <TextBlock
                    Grid.Row="3" Grid.Column="0"
                    Margin="0,8,0,0"
                    FontSize="11"
                    IsTextSelectionEnabled="True"
                    Opacity="0.6"
                    Text="{Binding QemuStatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />

            <!--
                Selected VM: a row of icon buttons (ToolbarIconButton), their names in the tooltips.

                Not a CommandBar: its overflow menu held one command and drew a mostly empty panel over the
                content, and a closed bar showed its labels only while that flyout was open. Then standalone
                AppBarButtons with labels under the icons, until the labels made the row run under Réseaux
                virtuels and Paramètres at the user's 1280 px; compact, they kept the room of the label under
                the icon, which then sat above the library's buttons. Plain buttons centre their icon.
            -->
            <StackPanel
                x:Name="MachineToolbar"
                Grid.Row="0" Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                    <StackPanel.Resources>
                        <!-- Clear in every state but hover and press, as the icons of a command bar. -->
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    </StackPanel.Resources>
                    <!--
                        FontIcon everywhere rather than Icon="Play": the built-in SymbolIcon draws at 20 px
                        against a 12 px label, which reads as oversized. FontIcon is the only one of the two
                        that takes a FontSize, so the glyphs are the Segoe Fluent codes behind the same
                        symbols. IconFontSize in App.xaml keeps the seven of them in step.
                    -->
                    <!--
                        AllowFocusOnInteraction: toolbar buttons do not take focus by default, so a NumberBox
                        being edited never lost it and kept its new value uncommitted — the VM then started
                        with the old one (a port forward launched with guest port 0). Taking focus on press
                        commits the edit before the command runs on release.
                    -->
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        AllowFocusOnInteraction="True"
                        Command="{Binding StartCommand}"
                        AutomationProperties.Name="{x:Bind ct:CommonText.Start}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarStartTip}"
                        Visibility="{Binding IsSelectedNotTemplate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE768;" />
                    </Button>
                    <!-- In Démarrer's place for a template, which is never started (MainViewModel.Templates). -->
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        Click="OnDeployClick"
                        IsEnabled="{Binding CanDeploy, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind t:WindowText.ToolbarDeploy}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarDeployTip}"
                        Visibility="{Binding IsSelectedTemplate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE7B8;" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding PauseResumeCommand}"
                        AutomationProperties.Name="{Binding PauseResumeLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarPauseTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE769;" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ShutdownCommand}"
                        AutomationProperties.Name="{x:Bind ct:CommonText.Stop}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarShutDownTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE71A;" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding PowerOffCommand}"
                        AutomationProperties.Name="{x:Bind ct:CommonText.PowerOff}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarPowerOffTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE711;" />
                    </Button>
                    <muxc:AppBarSeparator />
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding SendCtrlAltDeleteCommand}"
                        AutomationProperties.Name="{x:Bind t:WindowText.ToolbarCtrlAltDel}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarCtrlAltDelTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE765;" />
                    </Button>
                    <!-- The menu is built on each click: the host's devices and the guest's hold on them
                         change behind the application's back. -->
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        x:Name="UsbButton"
                        Click="OnUsbClick"
                        AutomationProperties.Name="USB"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarUsbTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE88E;" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        x:Name="SoundButton"
                        Click="OnSoundClick"
                        IsEnabled="{Binding CanAdjustSound, Mode=OneWay}"
                        AutomationProperties.Name="{Binding SoundLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarSoundTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="{Binding SoundGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        x:Name="PullFilesButton"
                        Click="OnPullFilesClick"
                        IsEnabled="{Binding CanSendFiles, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind t:WindowText.ToolbarPullFiles}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarPullFilesTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE896;" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        x:Name="SendFilesButton"
                        Click="OnSendFilesClick"
                        IsEnabled="{Binding CanSendFiles, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind t:WindowText.ToolbarSendFiles}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarSendFilesTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE898;" />
                    </Button>
                    <muxc:AppBarSeparator x:Name="LibrarySeparator" />
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        x:Name="CloneButton"
                        Click="OnCloneClick"
                        IsEnabled="{Binding CanClone, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind t:WindowText.ToolbarClone}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarCloneTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE8C8;" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        x:Name="ExportButton"
                        Click="OnExportClick"
                        IsEnabled="{Binding CanClone, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind t:WindowText.ToolbarExport}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarExportTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xEDE1;" />
                    </Button>
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        x:Name="DeleteButton"
                        Click="OnDeleteClick"
                        AutomationProperties.Name="{x:Bind ct:CommonText.Delete}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarDeleteTip}">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE74D;" />
                    </Button>
                    <!-- What the window is too narrow for (FitMachineToolbar). -->
                    <Button
                        Style="{StaticResource ToolbarIconButton}"
                        x:Name="MoreButton"
                        Click="OnMoreClick"
                        AutomationProperties.Name="{x:Bind t:WindowText.ToolbarMore}"
                        ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarMoreTip}"
                        Visibility="Collapsed">
                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE712;" />
                    </Button>
                </StackPanel>

            <!--
                Settings sits at the far right of the header band, not beside + and Actualiser: those act
                on the library, this acts on the application. Sharing the sidebar header also cost the
                title its last 40 px and trimmed "Machines virtuelles" to an ellipsis in narrow mode.
            -->
            <Button
                x:Name="SettingsButton"
                Grid.Row="0" Grid.Column="1"
                Width="36" Height="36" Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind ct:CommonText.Settings}"
                Click="OnSettingsClick"
                ToolTipService.ToolTip="{x:Bind ct:CommonText.Settings}">
                <muxc:SymbolIcon Symbol="Setting" />
            </Button>
            <!-- Beside Settings for the same reason: virtual networks belong to the application, not to a machine. -->
            <Button
                Grid.Row="0" Grid.Column="1"
                Width="36" Height="36" Margin="0,0,44,0" Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind t:WindowText.VirtualNetworks}"
                Click="OnVirtualNetworksClick"
                ToolTipService.ToolTip="{x:Bind t:WindowText.VirtualNetworks}">
                <FontIcon FontSize="16" Glyph="&#xE968;" />
            </Button>

            <!--
                A switcher plus two views, rather than a TabView. TabView does not bound the height of
                its content, so a ScrollViewer placed inside it never got a viewport smaller than its
                content and could not scroll — the summary was clipped instead, losing the log and half
                the resources panel. Here the content row is star-sized inside an already-bounded grid,
                which is what makes scrolling possible at all.
            -->
            <!-- From the search box's row down: the state, on a line of its own above the switcher, pushed the
                 summary down a row for one word. -->
            <Grid x:Name="ContentGrid" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Segmented switcher. Exclusivity is enforced in code so a click on the active view
                     cannot leave both views hidden. -->
                <Grid Grid.Row="0">
                    <StackPanel x:Name="ViewSwitcher" Orientation="Horizontal" Spacing="4">
                        <ToggleButton
                            x:Name="SummaryViewButton"
                            MinWidth="120"
                            Click="OnSummaryViewClick"
                            Content="{x:Bind t:WindowText.ViewSummary}"
                            IsChecked="True" />
                        <ToggleButton
                            x:Name="ConsoleViewButton"
                            MinWidth="120"
                            Click="OnConsoleViewClick"
                            Content="{x:Bind t:WindowText.ViewConsole}" />
                    </StackPanel>
                    <StackPanel
                        x:Name="StatePanel"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{x:Bind t:WindowText.HeaderState}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedStateText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!--
                    IsTabStop="True": a click on an empty part of the summary (below Ressources, say)
                    focuses the ScrollViewer, and one that cannot hold focus passes it to its first
                    focusable descendant, which was the machine's name box. Able to hold it, it keeps it.
                    Not AllowFocusOnInteraction="False": that reached every field inside, and no text box
                    in the summary could be clicked into any more.
                -->
                <ScrollViewer
                    x:Name="SummaryView"
                    Grid.Row="1"
                    IsTabStop="True"
                    VerticalScrollBarVisibility="Auto">
                    <!--
                        MinHeight tied to the viewport so the wide layout is unchanged: a ScrollViewer
                        measures its content against infinite height, which would collapse the log's
                        star-sized row instead of letting it fill the space.
                    -->
                    <Grid
                        ColumnSpacing="12"
                        MinHeight="{Binding ViewportHeight, ElementName=SummaryView}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ResourcesColumn" Width="320" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <!-- Kept usable when the content has to scroll instead of stretch. -->
                                <RowDefinition Height="*" MinHeight="240" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0" Grid.Column="0"
                                Padding="12"
                                Background="#11000000"
                                CornerRadius="8">
                              <StackPanel Spacing="12">
                                <StackPanel DataContext="{Binding SelectedVm, Mode=OneWay}">
                                    <!--
                                        Shown as text, renamed through a dialog: as a borderless text box
                                        it took stray focus and keystrokes, and the name is the folder's
                                        and the descriptor's name, not something to edit by accident.
                                    -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Next to Renommer, as both change what the machine is rather than its hardware. -->
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind t:WindowText.SummaryMakeTemplate}"
                                            Click="OnMakeTemplateClick"
                                            IsEnabled="{Binding DataContext.CanToggleTemplate, ElementName=RootGrid, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind t:WindowText.SummaryMakeTemplateTip}"
                                            Visibility="{Binding DataContext.IsSelectedNotTemplate, ElementName=RootGrid, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                                <TextBlock Text="{x:Bind t:WindowText.SummaryMakeTemplateButton}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            IsTextSelectionEnabled="True"
                                            Text="{Binding Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind t:WindowText.SummaryRename}"
                                            Click="OnRenameClick"
                                            ToolTipService.ToolTip="{x:Bind t:WindowText.SummaryRename}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon FontSize="14" Glyph="&#xE8AC;" />
                                                <TextBlock Text="{x:Bind t:WindowText.SummaryRenameButton}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <!--
                                        Shown next to the field rather than in the error bar at the top:
                                        this appears while a name is being typed, and the name is what
                                        has to be corrected. Nothing is written to disk until it clears.
                                    -->
                                    <TextBlock
                                        Margin="2,2,0,0"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource Hint}"
                                        Text="{Binding DataContext.NameError, ElementName=RootGrid, Mode=OneWay}"
                                        Visibility="{Binding DataContext.HasNameError, ElementName=RootGrid, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <!-- Visibility bound as well as IsOpen: a closed InfoBar still takes the panel's spacing. -->
                                    <muxc:InfoBar
                                        Margin="0,8,0,0"
                                        IsClosable="False"
                                        IsOpen="{Binding DataContext.IsSelectedTemplate, ElementName=RootGrid, Mode=OneWay}"
                                        Message="{x:Bind t:WindowText.TemplateBanner}"
                                        Severity="Informational"
                                        Title="{x:Bind t:WindowText.TemplateBannerTitle}"
                                        Visibility="{Binding DataContext.IsSelectedTemplate, ElementName=RootGrid, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <muxc:InfoBar.ActionButton>
                                            <Button
                                                Click="OnConvertToMachineClick"
                                                Content="{x:Bind t:WindowText.TemplateConvertBack}"
                                                IsEnabled="{Binding DataContext.CanToggleTemplate, ElementName=RootGrid, Mode=OneWay}" />
                                        </muxc:InfoBar.ActionButton>
                                    </muxc:InfoBar>
                                    <!-- One line until something is written: the empty 60-pixel box was the biggest thing in the summary. -->
                                    <TextBox
                                        MinHeight="32"
                                        MaxHeight="120"
                                        Margin="0,6,0,0"
                                        AcceptsReturn="True"
                                        AutomationProperties.Name="{x:Bind t:WindowText.SummaryDescription}"
                                        PlaceholderText="{x:Bind t:WindowText.SummaryDescription}"
                                        Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextWrapping="Wrap" />

                                    <Grid Margin="0,12,0,0" ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0" Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind t:WindowText.SummaryCpus}" />
                                        <muxc:NumberBox
                                            Grid.Row="0" Grid.Column="1"
                                            Maximum="64" Minimum="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{Binding CpuCount, Mode=TwoWay}" />

                                        <TextBlock
                                            Grid.Row="1" Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind t:WindowText.SummaryMemoryMb}" />
                                        <muxc:NumberBox
                                            Grid.Row="1" Grid.Column="1"
                                            Maximum="1048576" Minimum="128"
                                            SmallChange="512"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{Binding MemoryMb, Mode=TwoWay}" />

                                        <TextBlock
                                            Grid.Row="2" Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind t:WindowText.SummaryIso}" />
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Grid.Column="0"
                                                AutomationProperties.Name="{x:Bind t:WindowText.SummaryIsoPath}"
                                                PlaceholderText="{x:Bind t:WindowText.SummaryIsoNone}"
                                                Text="{Binding IsoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="1"
                                                AutomationProperties.Name="{x:Bind t:WindowText.SummaryIsoBrowse}"
                                                Click="OnBrowseIsoClick"
                                                Content="{x:Bind ct:CommonText.Browse}" />
                                            <!-- Swapping the medium is the one hardware change QEMU takes
                                                 without a restart, so this button is the opposite of the
                                                 rest: it is enabled only while the machine runs. -->
                                            <Button
                                                Grid.Column="2"
                                                Click="OnInsertIsoClick"
                                                Content="{x:Bind t:WindowText.SummaryIsoInsert}"
                                                IsEnabled="{Binding DataContext.CanChangeIsoLive, ElementName=RootGrid, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.SummaryIsoInsertTip}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Row="3" Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind t:WindowText.SummaryLocation}" />
                                        <TextBlock
                                            Grid.Row="3" Grid.Column="1"
                                            VerticalAlignment="Center"
                                            IsTextSelectionEnabled="True"
                                            Opacity="0.7"
                                            Text="{Binding FolderPath, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>

                                <!--
                                    Platform. Read at launch like the rest of the hardware, so it is locked
                                    while the machine is alive. The verdict below is the argument builder's
                                    own, shown as the settings are chosen rather than at a failed start:
                                    several of these combinations produce a machine that starts and then
                                    shows nothing at all.
                                -->
                                <muxc:Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.PlatformHeader}" />
                                    </muxc:Expander.Header>
                                    <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{Binding Hardware.CanEdit, Mode=OneWay}">
                                    <StackPanel DataContext="{Binding SelectedVm, Mode=OneWay}" Spacing="10">

                                        <Grid ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <ComboBox
                                                Grid.Row="0" Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{x:Bind t:WindowText.PlatformArchitecture}"
                                                Header="{x:Bind t:WindowText.PlatformArchitecture}"
                                                ItemsSource="{Binding DataContext.Hardware.ArchitectureOptions, ElementName=RootGrid}"
                                                SelectedItem="{Binding Architecture, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <ComboBox
                                                Grid.Row="0" Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{x:Bind t:WindowText.PlatformFirmware}"
                                                Header="{x:Bind t:WindowText.PlatformFirmware}"
                                                ItemsSource="{Binding DataContext.Hardware.FirmwareOptions, ElementName=RootGrid}"
                                                SelectedItem="{Binding Firmware, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <ComboBox
                                                Grid.Row="1" Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{x:Bind t:WindowText.PlatformAcceleration}"
                                                Header="{x:Bind t:WindowText.PlatformAcceleration}"
                                                ItemsSource="{Binding DataContext.Hardware.AcceleratorOptions, ElementName=RootGrid}"
                                                SelectedItem="{Binding Accelerator, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <!-- Editable: a machine type can carry sub-options, and the
                                                 list comes from this QEMU rather than from a guess. -->
                                            <ComboBox
                                                Grid.Row="1" Grid.Column="1"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{x:Bind t:WindowText.PlatformMachineType}"
                                                Header="{x:Bind t:WindowText.PlatformMachineType}"
                                                IsEditable="True"
                                                ItemsSource="{Binding DataContext.Hardware.MachineTypeOptions, ElementName=RootGrid}"
                                                PlaceholderText="q35"
                                                Text="{Binding DataContext.Hardware.MachineType, ElementName=RootGrid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <!-- Editable too: a CPU model is a name plus feature flags,
                                                 and the shipped default carries six of them. Both bound through
                                                 Hardware, which gives the text back once QEMU's list is in (an
                                                 editable box empties it when its items change). -->
                                            <ComboBox
                                                Grid.Row="2" Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{x:Bind t:WindowText.PlatformCpuModel}"
                                                Header="{x:Bind t:WindowText.PlatformCpuModel}"
                                                IsEditable="True"
                                                ItemsSource="{Binding DataContext.Hardware.CpuModelOptions, ElementName=RootGrid}"
                                                Text="{Binding DataContext.Hardware.CpuModel, ElementName=RootGrid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                            <muxc:NumberBox
                                                Grid.Row="2" Grid.Column="1"
                                                Maximum="64" Minimum="1"
                                                AutomationProperties.Name="{x:Bind t:WindowText.PlatformCoresPerSocket}"
                                                Header="{x:Bind t:WindowText.PlatformCoresPerSocketHeader}"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{Binding CoresPerSocket, Mode=TwoWay}" />
                                        </Grid>

                                        <!-- The CPU's options, kept apart from its model (CpuModelSpec), set in a dialog
                                             listing every flag QEMU recognizes. -->
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind t:WindowText.PlatformCpuOptions}" />
                                                <TextBlock
                                                    IsTextSelectionEnabled="True"
                                                    Text="{Binding DataContext.Hardware.CpuOptionsText, ElementName=RootGrid}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Click="OnCpuAdvancedClick"
                                                Content="{x:Bind t:WindowText.PlatformCpuAdvanced}" />
                                        </Grid>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox
                                                Grid.Column="0"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{x:Bind t:WindowText.PlatformGraphics}"
                                                Header="{x:Bind t:WindowText.PlatformGraphics}"
                                                ItemsSource="{Binding DataContext.Hardware.GraphicsOptions, ElementName=RootGrid}"
                                                SelectedItem="{Binding Graphics, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <muxc:NumberBox
                                                Grid.Column="1"
                                                Maximum="1024" Minimum="4"
                                                AutomationProperties.Name="{x:Bind t:WindowText.PlatformVideoMemory}"
                                                Header="{x:Bind t:WindowText.PlatformVideoMemoryHeader}"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{Binding VideoMemoryMb, Mode=TwoWay}" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <CheckBox Content="{x:Bind t:WindowText.PlatformSound}" IsChecked="{Binding EnableAudio, Mode=TwoWay}" />
                                            <CheckBox
                                                Content="{x:Bind t:WindowText.PlatformMicrophone}"
                                                IsChecked="{Binding EnableMicrophone, Mode=TwoWay}"
                                                IsEnabled="{Binding EnableAudio, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.PlatformMicrophoneTip}" />
                                            <CheckBox
                                                Content="{x:Bind t:WindowText.PlatformUsbTablet}"
                                                IsChecked="{Binding EnableUsbTablet, Mode=TwoWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.PlatformUsbTabletTip}" />
                                            <CheckBox
                                                Content="{x:Bind t:WindowText.PlatformBalloon}"
                                                IsChecked="{Binding EnableBalloon, Mode=TwoWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.PlatformBalloonTip}" />
                                            <CheckBox
                                                Content="{x:Bind t:WindowText.PlatformLocalTime}"
                                                IsChecked="{Binding RtcLocalTime, Mode=TwoWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.PlatformLocalTimeTip}" />
                                        </StackPanel>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Grid.Column="0"
                                                AutomationProperties.Name="{x:Bind t:WindowText.PlatformSecondIso}"
                                                Header="{x:Bind t:WindowText.PlatformSecondIsoHeader}"
                                                PlaceholderText="{x:Bind t:WindowText.PlatformSecondIsoNone}"
                                                Text="{Binding SecondaryIsoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="1"
                                                Margin="0,28,0,0"
                                                AutomationProperties.Name="{x:Bind t:WindowText.PlatformSecondIsoBrowse}"
                                                Click="OnBrowseSecondaryIsoClick"
                                                Content="{x:Bind ct:CommonText.Browse}" />
                                        </Grid>

                                        <TextBox
                                            AcceptsReturn="True"
                                            AutomationProperties.Name="{x:Bind t:WindowText.PlatformExtraArgs}"
                                            Header="{x:Bind t:WindowText.PlatformExtraArgsHeader}"
                                            Height="60"
                                            PlaceholderText="{x:Bind t:WindowText.PlatformExtraArgsPlaceholder}"
                                            Text="{Binding ExtraArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    </ContentControl>
                                </muxc:Expander>

                                <!-- Outside the lock: worth reading even while the machine runs. -->
                                <muxc:InfoBar
                                    IsClosable="False"
                                    IsOpen="{Binding Hardware.HasPlatformProblems, Mode=OneWay}"
                                    Visibility="{Binding Hardware.HasPlatformProblems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Message="{Binding Hardware.PlatformProblems, Mode=OneWay}"
                                    Severity="Error"
                                    Title="{x:Bind t:WindowText.PlatformProblemsTitle}" />

                                <muxc:Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.CommandLineHeader}" />
                                    </muxc:Expander.Header>
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{x:Bind t:WindowText.CommandLineHint}" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            IsTextSelectionEnabled="True"
                                            Text="{Binding Hardware.CommandPreview, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </muxc:Expander>

                                <!--
                                    Hardware. Collapsed by default: the three sections together are
                                    taller than the card, and the everyday questions ("is it running",
                                    "how much memory") are answered above without opening any of them.

                                    Bindings inside the item templates go through ElementName=RootGrid.
                                    A template's DataContext is the disk or adapter being drawn, so a
                                    plain {Binding Hardware.…} would look for the command on the model
                                    object and silently find nothing.
                                -->
                                <muxc:InfoBar
                                    IsClosable="False"
                                    IsOpen="{Binding Hardware.IsLocked, Mode=OneWay}"
                                    Visibility="{Binding Hardware.IsLocked, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                    Message="{x:Bind t:WindowText.HardwareLocked}"
                                    Severity="Informational" />

                                <muxc:Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.BootOrderHeader}" />
                                    </muxc:Expander.Header>
                                    <!--
                                        The lock goes on a ContentControl, not on the StackPanel:
                                        IsEnabled is declared by Control, and Panel does not have it.
                                        Binding it on a panel does not merely fail at runtime — it makes
                                        the XAML compiler exit with no diagnostic at all. The Expander
                                        itself stays enabled so the section can still be opened and read
                                        while the machine runs.
                                    -->
                                    <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{Binding Hardware.CanEdit, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{x:Bind t:WindowText.BootOrderHint}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ListView
                                                Grid.Column="0"
                                                MaxHeight="160"
                                                AutomationProperties.Name="{x:Bind t:WindowText.BootOrderHeader}"
                                                ItemsSource="{Binding Hardware.BootEntries, Mode=OneWay}"
                                                SelectedItem="{Binding Hardware.SelectedBootEntry, Mode=TwoWay}"
                                                SelectionMode="Single">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,4" Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Label}" />
                                                            <TextBlock Opacity="0.6" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="4">
                                                <Button
                                                    MinWidth="120"
                                                    Command="{Binding Hardware.MoveBootUpCommand}"
                                                    Content="{x:Bind t:WindowText.BootOrderUp}" />
                                                <Button
                                                    MinWidth="120"
                                                    Command="{Binding Hardware.MoveBootDownCommand}"
                                                    Content="{x:Bind t:WindowText.BootOrderDown}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    </ContentControl>
                                </muxc:Expander>

                                <muxc:Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.DisksHeader}" />
                                    </muxc:Expander.Header>
                                    <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{Binding Hardware.CanEdit, Mode=OneWay}">
                                    <StackPanel Spacing="8">
                                        <ItemsControl ItemsSource="{Binding Hardware.Disks, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <!-- x:DataType on every template whose texts come from x:Bind to the text classes: without it, WinUI
                                                     compiles those bindings but never runs them, and the disk buttons and boxes showed no text. -->
                                                <DataTemplate x:DataType="models:DiskConfig">
                                                    <Border
                                                        Margin="0,0,0,8"
                                                        Padding="10"
                                                        Background="#11000000"
                                                        CornerRadius="6">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding Id}" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    AutomationProperties.Name="{x:Bind t:WindowText.DiskImageFile}"
                                                                    Text="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                                    <!-- Icons, their names in the tooltips: four labelled buttons left the file name "disk0.qco" at
                                                                         the user's 1280 px (1920 x 1200 at 150 %). -->
                                                                    <Button
                                                                        Style="{StaticResource DiskIconButton}"
                                                                        AutomationProperties.Name="{x:Bind t:WindowText.DiskGrowName}"
                                                                        Click="OnGrowDiskClick"
                                                                        ToolTipService.ToolTip="{x:Bind t:WindowText.DiskGrow}">
                                                                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE740;" />
                                                                    </Button>
                                                                    <Button
                                                                        Style="{StaticResource DiskIconButton}"
                                                                        AutomationProperties.Name="{x:Bind t:WindowText.DiskConvertName}"
                                                                        Click="OnConvertDiskClick"
                                                                        ToolTipService.ToolTip="{x:Bind t:WindowText.DiskConvert}">
                                                                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE8AB;" />
                                                                    </Button>
                                                                    <Button
                                                                        Style="{StaticResource DiskIconButton}"
                                                                        AutomationProperties.Name="{x:Bind t:WindowText.DiskCompactName}"
                                                                        Click="OnCompactDiskClick">
                                                                        <ToolTipService.ToolTip>
                                                                            <StackPanel MaxWidth="320" Spacing="2">
                                                                                <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.DiskCompact}" />
                                                                                <TextBlock Text="{x:Bind t:WindowText.DiskCompactTip}" TextWrapping="Wrap" />
                                                                            </StackPanel>
                                                                        </ToolTipService.ToolTip>
                                                                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE73F;" />
                                                                    </Button>
                                                                    <Button
                                                                        Style="{StaticResource DiskIconButton}"
                                                                        AutomationProperties.Name="{x:Bind t:WindowText.DiskDetachName}"
                                                                        Command="{Binding DataContext.Hardware.RemoveDiskCommand, ElementName=RootGrid}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTipService.ToolTip="{x:Bind t:WindowText.DiskDetach}">
                                                                        <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE77A;" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>

                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <ComboBox
                                                                    Grid.Column="0"
                                                                    HorizontalAlignment="Stretch"
                                                                    AutomationProperties.Name="{x:Bind t:WindowText.DiskController}"
                                                                    Header="{x:Bind t:WindowText.DiskController}"
                                                                    ItemsSource="{Binding DataContext.Hardware.BusOptions, ElementName=RootGrid}"
                                                                    SelectedItem="{Binding Bus, Mode=TwoWay}">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <ComboBox
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Stretch"
                                                                    AutomationProperties.Name="{x:Bind t:WindowText.DiskCache}"
                                                                    Header="{x:Bind t:WindowText.DiskCache}"
                                                                    ItemsSource="{Binding DataContext.Hardware.CacheOptions, ElementName=RootGrid}"
                                                                    SelectedItem="{Binding Cache, Mode=TwoWay}" />

                                                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="2">
                                                                    <TextBlock
                                                                        Style="{StaticResource Hint}"
                                                                        Text="{Binding Format, Converter={StaticResource EnumLabel}}" />
                                                                    <TextBlock
                                                                        Style="{StaticResource Hint}"
                                                                        Text="{Binding CapacityBytes, Converter={StaticResource DiskCapacity}}" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- A linked clone's disk reads another machine's
                                                                 image: said where the disk is described, since
                                                                 moving either folder alone breaks the pair. -->
                                                            <TextBlock
                                                                Style="{StaticResource Hint}"
                                                                Visibility="{Binding IsLinkedClone, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                                <Run Text="{x:Bind t:WindowText.DiskLinkedClonePrefix}" /><Run Text="{Binding LinkedBaseFileName, Mode=OneWay}" /><Run Text="{x:Bind t:WindowText.DiskLinkedCloneSuffix}" />
                                                            </TextBlock>

                                                            <!-- Visible whenever the disk is a live-snapshot
                                                                 overlay, because the chain decides what a
                                                                 rollback would mean. -->
                                                            <StackPanel
                                                                Spacing="6"
                                                                Visibility="{Binding IsOverlay, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock
                                                                    Style="{StaticResource Hint}"
                                                                    Text="{Binding BackingFileName, Mode=OneWay}" />
                                                                <TextBlock Style="{StaticResource Hint}">
                                                                    <Run Text="{x:Bind t:WindowText.DiskOverlayLevels}" /><Run Text="{Binding OverlayDepth, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <Button
                                                                        AutomationProperties.Name="{x:Bind t:WindowText.DiskRevertToBase}"
                                                                        Click="OnDiscardOverlayClick"
                                                                        Content="{x:Bind t:WindowText.DiskRevertToBase}" />
                                                                    <Button
                                                                        AutomationProperties.Name="{x:Bind t:WindowText.DiskCommitName}"
                                                                        Click="OnCommitOverlayClick"
                                                                        Content="{x:Bind t:WindowText.DiskCommit}" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                                <CheckBox Content="{x:Bind t:WindowText.DiskReadOnly}" IsChecked="{Binding ReadOnly, Mode=TwoWay}" />
                                                                <CheckBox
                                                                    Content="{x:Bind t:WindowText.DiskDiscard}"
                                                                    IsChecked="{Binding Discard, Mode=TwoWay}"
                                                                    ToolTipService.ToolTip="{x:Bind t:WindowText.DiskDiscardTip}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{x:Bind t:WindowText.DisksHint}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Click="OnCreateDiskClick" Content="{x:Bind t:WindowText.DisksCreate}" />
                                            <Button Click="OnAttachDiskClick" Content="{x:Bind t:WindowText.DisksAttach}" />
                                        </StackPanel>
                                    </StackPanel>
                                    </ContentControl>
                                </muxc:Expander>

                                <muxc:Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.Network}" />
                                    </muxc:Expander.Header>
                                    <!--
                                        Not wholly behind Hardware.CanEdit: a card's cable plugs in and out live,
                                        like VMware's "Connected". The rest of each card waits for the machine to stop.
                                    -->
                                    <StackPanel Spacing="8">
                                        <ItemsControl ItemsSource="{Binding Hardware.Adapters, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:NetworkAdapterConfig">
                                                    <Border
                                                        Margin="0,0,0,8"
                                                        Padding="10"
                                                        Background="#11000000"
                                                        CornerRadius="6">
                                                        <StackPanel Spacing="8">
                                                        <ToggleSwitch
                                                            AutomationProperties.Name="{x:Bind t:WindowText.NetworkCableConnected}"
                                                            IsOn="{Binding Connected, Mode=TwoWay}"
                                                            OffContent="{x:Bind t:WindowText.NetworkCableDisconnected}"
                                                            OnContent="{x:Bind t:WindowText.NetworkCableConnected}"
                                                            Toggled="OnAdapterConnectedToggled" />
                                                        <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{Binding DataContext.Hardware.CanEdit, ElementName=RootGrid, Mode=OneWay}">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    Margin="0,0,0,6"
                                                                    VerticalAlignment="Bottom"
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding Id}" />

                                                                <!--
                                                                    NAT and the virtual networks in one list, as VMware lists NAT and
                                                                    its VMnets. Networks are referred to by id, so a rename in the
                                                                    network editor never unplugs a card.
                                                                -->
                                                                <ComboBox
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Stretch"
                                                                    AutomationProperties.Name="{x:Bind t:WindowText.NetworkConnection}"
                                                                    DisplayMemberPath="Label"
                                                                    Header="{x:Bind t:WindowText.NetworkConnection}"
                                                                    ItemsSource="{Binding DataContext.Hardware.ConnectionOptions, ElementName=RootGrid}"
                                                                    PlaceholderText="{x:Bind t:WindowText.NetworkConnectionPlaceholder}"
                                                                    SelectedValue="{Binding Connection, Mode=TwoWay}"
                                                                    SelectedValuePath="Key" />

                                                                <ComboBox
                                                                    Grid.Column="2"
                                                                    HorizontalAlignment="Stretch"
                                                                    AutomationProperties.Name="{x:Bind t:WindowText.NetworkAdapterModel}"
                                                                    Header="{x:Bind t:WindowText.NetworkAdapter}"
                                                                    ItemsSource="{Binding DataContext.Hardware.NicModelOptions, ElementName=RootGrid}"
                                                                    SelectedItem="{Binding Model, Mode=TwoWay}" />

                                                                <Button
                                                                    Grid.Column="3"
                                                                    Margin="0,0,0,1"
                                                                    VerticalAlignment="Bottom"
                                                                    Command="{Binding DataContext.Hardware.RemoveAdapterCommand, ElementName=RootGrid}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="{x:Bind ct:CommonText.Remove}" />
                                                            </Grid>

                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    VerticalAlignment="Center"
                                                                    Text="{x:Bind t:WindowText.NetworkMac}" />
                                                                <TextBox
                                                                    Grid.Column="1"
                                                                    AutomationProperties.Name="{x:Bind t:WindowText.NetworkMac}"
                                                                    PlaceholderText="{x:Bind t:WindowText.NetworkMacPlaceholder}"
                                                                    Text="{Binding MacAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <Button
                                                                    Grid.Column="2"
                                                                    Command="{Binding DataContext.Hardware.GenerateMacCommand, ElementName=RootGrid}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="{x:Bind t:WindowText.NetworkMacGenerate}" />
                                                            </Grid>

                                                            <!-- Mode-specific fields, hidden where they would be ignored. -->
                                                            <TextBox
                                                                AutomationProperties.Name="{x:Bind t:WindowText.NetworkTap}"
                                                                Header="{x:Bind t:WindowText.NetworkTapHeader}"
                                                                Text="{Binding BridgeInterface, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Visibility="{Binding Mode, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Bridged}" />


                                                            <StackPanel
                                                                Spacing="6"
                                                                Visibility="{Binding Mode, Converter={StaticResource EnumMatchVisibility}, ConverterParameter=Nat}">
                                                                <TextBlock Style="{StaticResource Hint}"
                                                                           Text="{x:Bind t:WindowText.NetworkNatHint}" />
                                                                <ItemsControl ItemsSource="{Binding PortForwards}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:PortForward">
                                                                            <Grid Margin="0,0,0,6" ColumnSpacing="8">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>

                                                                                <ComboBox
                                                                                    Grid.Column="0"
                                                                                    AutomationProperties.Name="{x:Bind t:WindowText.NetworkProtocol}"
                                                                                    ItemsSource="{Binding DataContext.Hardware.ProtocolOptions, ElementName=RootGrid}"
                                                                                    SelectedItem="{Binding Protocol, Mode=TwoWay}" />
                                                                                <TextBox
                                                                                    Grid.Column="1"
                                                                                    AutomationProperties.Name="{x:Bind t:WindowText.NetworkHostAddress}"
                                                                                    PlaceholderText="127.0.0.1"
                                                                                    Text="{Binding HostAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                <muxc:NumberBox
                                                                                    Grid.Column="2"
                                                                                    Maximum="65535" Minimum="0"
                                                                                    AutomationProperties.Name="{x:Bind t:WindowText.NetworkHostPort}"
                                                                                    PlaceholderText="{x:Bind t:WindowText.NetworkHostPort}"
                                                                                    Value="{Binding HostPort, Mode=TwoWay}" />
                                                                                <muxc:NumberBox
                                                                                    Grid.Column="3"
                                                                                    Maximum="65535" Minimum="0"
                                                                                    AutomationProperties.Name="{x:Bind t:WindowText.NetworkGuestPort}"
                                                                                    PlaceholderText="{x:Bind t:WindowText.NetworkGuestPort}"
                                                                                    Value="{Binding GuestPort, Mode=TwoWay}" />
                                                                                <Button
                                                                                    Grid.Column="4"
                                                                                    Command="{Binding DataContext.Hardware.RemovePortForwardCommand, ElementName=RootGrid}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Content="{x:Bind ct:CommonText.Remove}" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button
                                                                    HorizontalAlignment="Left"
                                                                    Command="{Binding DataContext.Hardware.AddPortForwardCommand, ElementName=RootGrid}"
                                                                    CommandParameter="{Binding}"
                                                                    Content="{x:Bind t:WindowText.NetworkAddPortForward}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        </ContentControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button
                                            HorizontalAlignment="Left"
                                            Command="{Binding Hardware.AddAdapterCommand}"
                                            Content="{x:Bind t:WindowText.NetworkAddAdapter}" />
                                    </StackPanel>
                                </muxc:Expander>
                                <!--
                                    Access from the network: host forwards on every interface, instead of a
                                    bridged network this QEMU build cannot offer (see LanAccess). Not behind
                                    Hardware.CanEdit: forwards open and close live on a running machine.
                                -->
                                <muxc:Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Expanding="OnLanAccessExpanding">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.LanAccessHeader}" />
                                    </muxc:Expander.Header>
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{Binding LanAccessHint, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <muxc:InfoBar
                                            IsClosable="False"
                                            IsOpen="{Binding HasFirewallWarning, Mode=OneWay}"
                                            Visibility="{Binding HasFirewallWarning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Message="{Binding FirewallWarning, Mode=OneWay}"
                                            Severity="Warning"
                                            Title="{x:Bind t:WindowText.LanAccessFirewall}">
                                            <muxc:InfoBar.ActionButton>
                                                <Button Click="OnAllowFirewallClick" Content="{x:Bind t:WindowText.LanAccessAllowQemu}" />
                                            </muxc:InfoBar.ActionButton>
                                        </muxc:InfoBar>
                                        <ItemsControl ItemsSource="{Binding LanServices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LanServiceItem">
                                                    <Border
                                                        Margin="0,0,0,8"
                                                        Padding="10"
                                                        Background="#11000000"
                                                        CornerRadius="6">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                                                <TextBlock
                                                                    FontFamily="Consolas"
                                                                    IsTextSelectionEnabled="True"
                                                                    Text="{Binding Usage}"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Button
                                                                Grid.Column="1"
                                                                VerticalAlignment="Top"
                                                                Click="OnCloseServiceClick"
                                                                Content="{x:Bind ct:CommonText.Close}"
                                                                Tag="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button
                                            x:Name="OpenServiceButton"
                                            HorizontalAlignment="Left"
                                            Click="OnOpenServiceClick"
                                            Content="{x:Bind t:WindowText.LanAccessOpenService}"
                                            IsEnabled="{Binding HasNatAdapter, Mode=OneWay}" />
                                    </StackPanel>
                                </muxc:Expander>

                                <!-- Guest tools (Services.GuestTools): what the guest has, and their installation. -->
                                <muxc:Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.GuestToolsHeader}" />
                                    </muxc:Expander.Header>
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{x:Bind t:WindowText.GuestToolsHint}"
                                            TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding GuestToolsText, Mode=OneWay}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasGuestToolsText, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Click="OnInstallGuestToolsClick"
                                                Content="{x:Bind t:WindowText.GuestToolsInstall}"
                                                IsEnabled="{Binding CanInstallGuestTools, Mode=OneWay}" />
                                            <Button
                                                Click="OnTrimGuestDisksClick"
                                                Content="{x:Bind t:WindowText.GuestToolsTrim}"
                                                IsEnabled="{Binding CanTrimGuestDisks, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.GuestToolsTrimTip}" />
                                        </StackPanel>
                                    </StackPanel>
                                </muxc:Expander>

                                <!-- Start with WinQEMU (Models.AutoStartPlan), as Hyper-V's automatic start: any time, running or not. -->
                                <muxc:Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.AutoStartHeader}" />
                                    </muxc:Expander.Header>
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{x:Bind t:WindowText.AutoStartHint}"
                                            TextWrapping="Wrap" />
                                        <CheckBox Content="{x:Bind t:WindowText.AutoStartEnable}" IsChecked="{Binding SelectedVm.AutoStart, Mode=TwoWay}" />
                                        <muxc:NumberBox
                                            HorizontalAlignment="Left"
                                            MinWidth="200"
                                            Header="{x:Bind t:WindowText.AutoStartDelay}"
                                            IsEnabled="{Binding SelectedVm.AutoStart, Mode=OneWay}"
                                            Maximum="3600"
                                            Minimum="0"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{Binding SelectedVm.AutoStartDelaySeconds, Mode=TwoWay}" />
                                    </StackPanel>
                                </muxc:Expander>

                                <!--
                                    Disk encryption (Core.Qemu.DiskKey), as VMware's VM encryption for the disks: LUKS
                                    qcow2 under one password. Rewriting needs the machine stopped; why an action is
                                    refused is said on click (MainWindow.Encryption.cs).
                                -->
                                <muxc:Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ct:EncryptionText.SectionHeader}" />
                                    </muxc:Expander.Header>
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{x:Bind ct:EncryptionText.SectionHint}"
                                            TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding EncryptionStatusText, Mode=OneWay}" TextWrapping="Wrap" />
                                        <!-- Only the actions that apply to this machine, on as many lines as the column needs. -->
                                        <controls:WrapPanel>
                                            <Button
                                                Click="OnEncryptDisksClick"
                                                Content="{x:Bind ct:EncryptionText.EncryptAction}"
                                                IsEnabled="{Binding CanEncryptSelected, Mode=OneWay}"
                                                Visibility="{Binding IsSelectedClear, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <Button
                                                Click="OnChangeDiskPasswordClick"
                                                Content="{x:Bind ct:EncryptionText.ChangeAction}"
                                                IsEnabled="{Binding CanChangeSelectedPassword, Mode=OneWay}"
                                                Visibility="{Binding IsSelectedEncrypted, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <Button
                                                Click="OnDecryptDisksClick"
                                                Content="{x:Bind ct:EncryptionText.DecryptAction}"
                                                IsEnabled="{Binding CanDecryptSelected, Mode=OneWay}"
                                                Visibility="{Binding IsSelectedEncrypted, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                            <Button
                                                Click="OnForgetDiskPasswordClick"
                                                Content="{x:Bind ct:EncryptionText.ForgetAction}"
                                                IsEnabled="{Binding CanForgetSelectedPassword, Mode=OneWay}"
                                                Visibility="{Binding IsSelectedPasswordRemembered, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        </controls:WrapPanel>
                                    </StackPanel>
                                </muxc:Expander>

                                <!--
                                    Shared folders, served by WinQEMU itself (Sharing.NinePServer). Not behind
                                    Hardware.CanEdit: they are served live, so they can change while it runs.
                                -->
                                <muxc:Expander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.SharedFoldersHeader}" />
                                    </muxc:Expander.Header>
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{Binding SharedFolderHint, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            IsTextSelectionEnabled="True"
                                            Text="{Binding SharedFolderStatus, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasSharedFolderStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl ItemsSource="{Binding SelectedVm.SharedFolders, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SharedFolderConfig">
                                                    <Border
                                                        Margin="0,0,0,8"
                                                        Padding="10"
                                                        Background="#11000000"
                                                        CornerRadius="6">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Text="{Binding HostPath}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock IsTextSelectionEnabled="True">
                                                                    <Run Text="{Binding GuestPath}" /><Run Text=" · " /><Run Text="{Binding AccessText}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button
                                                                Grid.Column="1"
                                                                VerticalAlignment="Top"
                                                                Click="OnUnshareFolderClick"
                                                                Content="{x:Bind ct:CommonText.Remove}"
                                                                Tag="{Binding}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Click="OnShareFolderClick" Content="{x:Bind t:WindowText.SharedFoldersShare}" />
                                            <Button Click="OnShareFolderReadOnlyClick" Content="{x:Bind t:WindowText.SharedFoldersShareReadOnly}" />
                                        </StackPanel>
                                    </StackPanel>
                                </muxc:Expander>

                                <!--
                                    Snapshots. Opening the section is what loads the list: reading it
                                    runs qemu-img once per disk, and doing that on every selection change
                                    made arrowing through the inventory sluggish. Bound rather than handled
                                    through Expanding, so the view model also knows the section stays open
                                    when another machine is selected — that event never fires again then,
                                    and the list stayed empty or showed nothing until it was reopened.
                                -->
                                <muxc:Expander
                                    x:Name="SnapshotsExpander"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    IsExpanded="{Binding Snapshots.IsSectionExpanded, Mode=TwoWay}">
                                    <muxc:Expander.Header>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind t:WindowText.SnapshotsHeader}" />
                                    </muxc:Expander.Header>
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{x:Bind t:WindowText.SnapshotsHint}" />

                                        <muxc:InfoBar
                                            IsClosable="False"
                                            IsOpen="{Binding Snapshots.HasExcludedDisks, Mode=OneWay}"
                                            Visibility="{Binding Snapshots.HasExcludedDisks, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Message="{Binding Snapshots.ExcludedDisksText, Mode=OneWay}"
                                            Severity="Warning" />

                                        <!-- Automatic snapshots (Services.AutoSnapshots): any time, running or not. -->
                                        <!-- Wraps: on one line it ran past the section's edge in an 800-pixel window. -->
                                        <controls:WrapPanel HorizontalSpacing="12">
                                            <CheckBox
                                                VerticalAlignment="Center"
                                                Content="{x:Bind t:WindowText.SnapshotsAuto}"
                                                IsChecked="{Binding SelectedVm.AutoSnapshot, Mode=TwoWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.SnapshotsAutoTip}" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <ComboBox
                                                    MinWidth="230"
                                                    AutomationProperties.Name="{x:Bind t:WindowText.SnapshotsAutoFrequency}"
                                                    DisplayMemberPath="Label"
                                                    IsEnabled="{Binding SelectedVm.AutoSnapshot, Mode=OneWay}"
                                                    ItemsSource="{Binding AutoSnapshotIntervals, Mode=OneTime}"
                                                    SelectedValue="{Binding SelectedVm.AutoSnapshotHours, Mode=TwoWay}"
                                                    SelectedValuePath="Hours" />
                                                <muxc:NumberBox
                                                    AutomationProperties.Name="{x:Bind t:WindowText.SnapshotsAutoKeepName}"
                                                    IsEnabled="{Binding SelectedVm.AutoSnapshot, Mode=OneWay}"
                                                    Maximum="50"
                                                    Minimum="1"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{Binding SelectedVm.AutoSnapshotKeep, Mode=TwoWay}" />
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" Text="{x:Bind t:WindowText.SnapshotsAutoKept}" />
                                            </StackPanel>
                                        </controls:WrapPanel>

                                        <!--
                                            The snapshots as a tree, drawn downwards like a file tree so that it
                                            fits the summary's width (SnapshotTree for the shape, SnapshotTreeView
                                            for the drawing). A click on a snapshot selects it for the buttons
                                            below; a click on a linked clone opens that machine.
                                        -->
                                        <ScrollViewer
                                            MaxHeight="400"
                                            HorizontalScrollBarVisibility="Auto"
                                            HorizontalScrollMode="Enabled"
                                            IsTabStop="True"
                                            VerticalScrollBarVisibility="Auto">
                                            <controls:SnapshotTreeView
                                                x:Name="SnapshotTreeDrawing"
                                                Margin="0,4,0,4"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="{x:Bind t:WindowText.SnapshotsTree}" />
                                        </ScrollViewer>

                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{Binding Snapshots.Status, Mode=OneWay}"
                                            Visibility="{Binding Snapshots.HasStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Grid.Column="0"
                                                AutomationProperties.Name="{x:Bind t:WindowText.SnapshotsNewName}"
                                                IsEnabled="{Binding Snapshots.CanEnterName, Mode=OneWay}"
                                                PlaceholderText="{x:Bind t:WindowText.SnapshotsNewName}"
                                                Text="{Binding Snapshots.NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Grid.Column="1"
                                                Click="OnCreateSnapshotClick"
                                                Content="{x:Bind t:WindowText.SnapshotsTakeOffline}"
                                                IsEnabled="{Binding Snapshots.CanCreate, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.SnapshotsTakeOfflineTip}" />
                                        </Grid>

                                        <!-- The three ways differ in what they capture and, above all, in
                                             how they are undone; they are offered side by side so the
                                             difference is visible at the moment of choosing. -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Click="OnLiveSnapshotClick"
                                                Content="{x:Bind t:WindowText.SnapshotsTakeLive}"
                                                IsEnabled="{Binding Snapshots.CanTakeLiveSnapshot, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.SnapshotsTakeLiveTip}" />
                                            <Button
                                                Click="OnMemorySnapshotClick"
                                                Content="{x:Bind t:WindowText.SnapshotsTakeMemory}"
                                                IsEnabled="{Binding Snapshots.CanTakeMemorySnapshot, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.SnapshotsTakeMemoryTip}" />
                                        </StackPanel>

                                        <muxc:InfoBar
                                            IsClosable="False"
                                            IsOpen="{Binding Snapshots.HasMemorySnapshotCaveat, Mode=OneWay}"
                                            Visibility="{Binding Snapshots.HasMemorySnapshotCaveat, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                            Message="{Binding Snapshots.MemorySnapshotUnavailableReason, Mode=OneWay}"
                                            Severity="Informational" />

                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource Hint}"
                                            Text="{Binding Snapshots.NameProblem, Mode=OneWay}" />

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <!-- Named for automation and screen readers: "Restaurer" and
                                                 "Supprimer" alone are indistinguishable from the toolbar
                                                 commands that delete the whole machine. -->
                                            <Button
                                                AutomationProperties.Name="{x:Bind t:WindowText.SnapshotsRestoreName}"
                                                Click="OnRestoreSnapshotClick"
                                                Content="{x:Bind t:WindowText.SnapshotsRestore}"
                                                IsEnabled="{Binding Snapshots.CanActOnSelection, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.SnapshotsRestoreTip}" />
                                            <Button
                                                AutomationProperties.Name="{x:Bind t:WindowText.SnapshotsResumeName}"
                                                Click="OnResumeSnapshotClick"
                                                Content="{x:Bind ct:CommonText.Resume}"
                                                IsEnabled="{Binding Snapshots.CanResumeSelection, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind t:WindowText.SnapshotsResumeTip}" />
                                            <Button
                                                AutomationProperties.Name="{x:Bind t:WindowText.SnapshotsDeleteName}"
                                                Click="OnDeleteSnapshotClick"
                                                Content="{x:Bind ct:CommonText.Delete}"
                                                IsEnabled="{Binding Snapshots.CanDeleteSelection, Mode=OneWay}" />
                                            <Button
                                                AutomationProperties.Name="{x:Bind t:WindowText.SnapshotsRefreshName}"
                                                Click="OnRefreshSnapshotsClick"
                                                Content="{x:Bind t:WindowText.SnapshotsRefresh}" />
                                            <muxc:ProgressRing
                                                Width="20" Height="20"
                                                VerticalAlignment="Center"
                                                IsActive="{Binding Snapshots.IsBusy, Mode=OneWay}" />
                                        </StackPanel>

                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{Binding Snapshots.SelectedLockReason, Mode=OneWay}"
                                            Visibility="{Binding Snapshots.IsSelectionLocked, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{x:Bind t:WindowText.SnapshotsLockedHint}"
                                            Visibility="{Binding Snapshots.IsLockedByRunningMachine, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Style="{StaticResource Hint}"
                                            Text="{x:Bind t:WindowText.SnapshotsTemplateHint}"
                                            Visibility="{Binding Snapshots.IsLockedByTemplate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </muxc:Expander>

                              </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="2" Grid.Column="0"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#11000000"
                                CornerRadius="8">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{x:Bind t:WindowText.LogHeader}" />
                                    <!--
                                        A single text block, not a ListView: thousands of list items
                                        blow up the accessibility tree and stall the UI thread when
                                        anything walks it.
                                    -->
                                    <!--
                                        No horizontal scrolling: with it, the TextBlock is measured
                                        against infinite width and never wraps, so long QEMU lines were
                                        simply cut off — which is what forced reading the log elsewhere
                                        to find a launch error.
                                    -->
                                    <ScrollViewer
                                        x:Name="LogScroller"
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <TextBlock
                                            Margin="4"
                                            AutomationProperties.Name="{x:Bind t:WindowText.LogHeader}"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            IsTextSelectionEnabled="True"
                                            Text="{Binding LogText, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="ResourcesPanel"
                                Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                Padding="12"
                                VerticalAlignment="Top"
                                Background="#11000000"
                                CornerRadius="8">
                                <!--
                                    The last two minutes, one chart per measure (MetricChart), as Hyper-V's
                                    manager shows them; sampled for every running machine, so they are full
                                    when one is selected. Drawn from code after each sample.
                                -->
                                <StackPanel MinWidth="260" Spacing="14">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind t:WindowText.ResourcesHeader}" />
                                    <!-- Empty charts for a machine that is off said nothing a line of text does not say better. -->
                                    <TextBlock
                                        Style="{StaticResource Hint}"
                                        Text="{x:Bind t:WindowText.ResourcesWhenOff}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding IsSelectedOff, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Spacing="14" Visibility="{Binding IsSelectedAlive, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <controls:MetricChart x:Name="CpuChart" Title="{x:Bind t:WindowText.ResourcesCpu}" />
                                        <controls:MetricChart x:Name="MemoryChart" Title="{x:Bind t:WindowText.ResourcesMemory}" />
                                        <controls:MetricChart x:Name="DiskChart" Title="{x:Bind t:WindowText.ResourcesDisk}" />
                                        <controls:MetricChart x:Name="NetworkChart" Title="{x:Bind t:WindowText.Network}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding CpuText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                </ScrollViewer>

                <Grid
                    x:Name="ConsoleView"
                    Grid.Row="1"
                    RowSpacing="8"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- One line, whatever it shows: a bar that changed height when a copy's progress replaced the hint
                         resized the console, and the guest's resolution with it, at the start and end of every copy. -->
                    <Grid x:Name="ConsoleBar" Grid.Row="0" Height="32" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="ConsoleHintText"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Opacity="0.6"
                            Text="{x:Bind t:WindowText.ConsoleHint}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind t:WindowText.ConsoleHint}"
                            Visibility="{Binding ShowConsoleHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Missing guest tools: a click installs them. -->
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowGuestToolsWarning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding GuestToolsWarning, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton
                                Padding="4,0"
                                Click="OnInstallGuestToolsClick"
                                Content="{x:Bind t:WindowText.GuestToolsInstall}"
                                FontSize="12"
                                Visibility="{Binding CanInstallGuestTools, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <!-- Files sent to the guest: the copy under way (with its cancel), then how it ended. -->
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasSendFilesStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar
                                Width="160"
                                VerticalAlignment="Center"
                                Maximum="100"
                                Value="{Binding SendFilesPercent, Mode=OneWay}"
                                Visibility="{Binding IsSendingFiles, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding SendFilesStatus, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Command="{Binding CancelSendFilesCommand}"
                                Content="{x:Bind ct:CommonText.Cancel}"
                                Visibility="{Binding IsSendingFiles, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <StackPanel x:Name="ConsoleScaleControls" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="GuestSizeText"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Opacity="0.6" />
                            <ComboBox
                                x:Name="ScaleModeBox"
                                MinWidth="150"
                                AutomationProperties.Name="{x:Bind t:WindowText.ConsoleScaling}"
                                SelectionChanged="OnScaleModeChanged" />
                            </StackPanel>
                            <!-- No AutomationProperties.Name: it would freeze the accessible name at
                                 "Plein écran" while the label alternates with "Quitter le plein écran",
                                 so the content is left to name the button. -->
                            <!-- For a guest without a clipboard agent (a server's text console): the text is typed. -->
                            <Button
                                Click="OnTypeClipboardClick"
                                IsEnabled="{Binding CanTypeIntoGuest, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind t:WindowText.ConsoleTypeClipboard}"
                                ToolTipService.ToolTip="{x:Bind t:WindowText.ConsoleTypeClipboardTip}">
                                <FontIcon FontSize="16" Glyph="&#xE77F;" />
                            </Button>
                            <Button
                                Click="OnCaptureClick"
                                IsEnabled="{Binding CanCapture, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind t:WindowText.ConsoleCapture}"
                                ToolTipService.ToolTip="{x:Bind t:WindowText.ConsoleCaptureTip}">
                                <FontIcon FontSize="16" Glyph="&#xE722;" />
                            </Button>
                            <Button
                                x:Name="FullScreenButton"
                                Click="OnToggleFullScreenClick"
                                Content="{x:Bind t:WindowText.ConsoleFullScreen}"
                                ToolTipService.ToolTip="{x:Bind t:WindowText.ConsoleFullScreenTip}" />
                        </StackPanel>
                    </Grid>

                    <!-- Drops over QEMU's window are taken by DropCatcher; these handlers take those on the frame
                         around it and on the placeholder. -->
                    <Border
                        x:Name="ConsoleFrame"
                        Grid.Row="1"
                        AllowDrop="True"
                        Background="Transparent"
                        CornerRadius="8"
                        DragEnter="OnConsoleDragEnter"
                        DragOver="OnConsoleDragOver"
                        Drop="OnConsoleDrop">
                        <controls:VmConsoleHost x:Name="ConsoleHost" AllowDrop="True" />
                    </Border>
                </Grid>
            </Grid>

            <!--
                A folder selected: its summary, over the machine's views (empty then: no machine is selected).
                Laid over them rather than hiding them, so the views and the console's place in the layout never
                change; the console itself is detached while a folder is selected, so nothing native covers this.
            -->
            <Grid
                Grid.Row="2" Grid.Column="1"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Visibility="{Binding IsFolderSelected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Border
                    Padding="16"
                    VerticalAlignment="Top"
                    Background="#11000000"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="12" Opacity="0.6" Text="{x:Bind t:LibraryText.FolderLabel}" />
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedFolder.Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedFolder.Summary, Mode=OneWay}" />
                        <TextBlock Opacity="0.7" Text="{Binding SelectedFolder.ParentPathText, Mode=OneWay}" TextWrapping="Wrap" />
                        <!-- Its machines as one, subfolders included (MainViewModel.Folders), as VMware's teams. -->
                        <controls:WrapPanel Margin="0,8,0,0" HorizontalSpacing="8" VerticalSpacing="8">
                            <Button Click="OnStartFolderClick" AutomationProperties.Name="{x:Bind t:LibraryText.FolderStart}" IsEnabled="{Binding CanStartFolder, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind t:LibraryText.FolderStartTip}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                    <TextBlock Text="{x:Bind t:LibraryText.FolderStart}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnStopFolderClick" AutomationProperties.Name="{x:Bind t:LibraryText.FolderStop}" IsEnabled="{Binding CanStopFolder, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind t:LibraryText.FolderStopTip}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE71A;" />
                                    <TextBlock Text="{x:Bind t:LibraryText.FolderStop}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnPauseFolderClick" AutomationProperties.Name="{x:Bind t:LibraryText.FolderPause}" IsEnabled="{Binding CanPauseFolder, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE769;" />
                                    <TextBlock Text="{x:Bind t:LibraryText.FolderPause}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnResumeFolderClick" AutomationProperties.Name="{x:Bind t:LibraryText.FolderResume}" IsEnabled="{Binding CanResumeFolder, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                                    <TextBlock Text="{x:Bind t:LibraryText.FolderResume}" />
                                </StackPanel>
                            </Button>
                        </controls:WrapPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12"
                                    Visibility="{Binding IsStartingFolder, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <muxc:ProgressRing Width="16" Height="16" IsActive="{Binding IsStartingFolder, Mode=OneWay}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding FolderStartStatus, Mode=OneWay}" TextWrapping="Wrap" />
                            <Button Click="OnCancelFolderStartClick" Content="{x:Bind ct:CommonText.Cancel}" />
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                            <Button Click="OnNewFolderClick">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                                    <TextBlock Text="{x:Bind t:LibraryText.NewSubfolder}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnRenameFolderClick" Content="{x:Bind t:LibraryText.RenameFolder}" />
                            <Button Click="OnDeleteFolderClick" Content="{x:Bind t:LibraryText.DeleteFolder}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Opacity="0.6"
                            Text="{x:Bind t:LibraryText.FolderSummaryHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <!--
            Full screen's only chrome, shown while the pointer touches the top of the screen. It cannot
            simply float over the console: a native child window is always drawn above XAML. So the
            console is told to leave this strip out of its visible region while the bar shows
            (VmConsoleHost.TopOverlayHeight); the guest image keeps its size and position.
        -->
        <Border
            x:Name="FullScreenBar"
            Grid.Row="0" Grid.RowSpan="2"
            Height="48"
            Margin="0,8,0,0"
            Padding="12,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock
                    x:Name="FullScreenTitle"
                    MaxWidth="320"
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis" />
                <!-- The machine's own commands, as in the toolbar the full screen hides: same bindings, so each
                     is enabled exactly when it is there. Icons alone, as there, their names in the tooltips. -->
                <Button Style="{StaticResource FullScreenIconButton}" Command="{Binding StartCommand}"
                        AutomationProperties.Name="{x:Bind ct:CommonText.Start}" ToolTipService.ToolTip="{x:Bind t:WindowText.FullScreenStartTip}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE768;" />
                </Button>
                <Button Style="{StaticResource FullScreenIconButton}" Command="{Binding PauseResumeCommand}"
                        AutomationProperties.Name="{Binding PauseResumeLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarPauseTip}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE769;" />
                </Button>
                <Button Style="{StaticResource FullScreenIconButton}" Command="{Binding ShutdownCommand}"
                        AutomationProperties.Name="{x:Bind ct:CommonText.Stop}" ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarShutDownTip}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE71A;" />
                </Button>
                <Button Style="{StaticResource FullScreenIconButton}" Command="{Binding PowerOffCommand}"
                        AutomationProperties.Name="{x:Bind ct:CommonText.PowerOff}" ToolTipService.ToolTip="{x:Bind t:WindowText.FullScreenPowerOffTip}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE711;" />
                </Button>
                <Border Width="1" Height="24" Margin="4,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button Style="{StaticResource FullScreenIconButton}" Command="{Binding SendCtrlAltDeleteCommand}"
                        AutomationProperties.Name="{x:Bind t:WindowText.ToolbarCtrlAltDel}" ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarCtrlAltDelTip}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE765;" />
                </Button>
                <Button Style="{StaticResource FullScreenIconButton}" x:Name="FullScreenUsbButton" Click="OnUsbClick"
                        AutomationProperties.Name="USB" ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarUsbTip}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE88E;" />
                </Button>
                <Button Style="{StaticResource FullScreenIconButton}" Click="OnSendFilesClick" IsEnabled="{Binding CanSendFiles, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind t:WindowText.FullScreenSendFiles}" ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarSendFilesTip}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE898;" />
                </Button>
                <Button Style="{StaticResource FullScreenIconButton}" Click="OnPullFilesClick" IsEnabled="{Binding CanSendFiles, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind t:WindowText.FullScreenPullFiles}" ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarPullFilesTip}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE896;" />
                </Button>
                <Button Style="{StaticResource FullScreenIconButton}" Click="OnSoundClick" IsEnabled="{Binding CanAdjustSound, Mode=OneWay}"
                        AutomationProperties.Name="{Binding SoundLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind t:WindowText.ToolbarSoundTip}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="{Binding SoundGlyph, Mode=OneWay}" />
                </Button>
                <Button Style="{StaticResource FullScreenIconButton}" Click="OnTypeClipboardClick" IsEnabled="{Binding CanTypeIntoGuest, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind t:WindowText.ConsoleTypeClipboard}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE77F;" />
                </Button>
                <Button Style="{StaticResource FullScreenIconButton}" Click="OnCaptureClick" IsEnabled="{Binding CanCapture, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind t:WindowText.ConsoleCapture}" ToolTipService.ToolTip="{x:Bind t:WindowText.ConsoleCaptureTip}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE722;" />
                </Button>
                <!-- The way out, the same size as the others; the accent colour tells it apart. -->
                <Button Width="40" Height="34" Padding="0" Click="OnToggleFullScreenClick" Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="{x:Bind t:WindowText.FullScreenExit}">
                    <FontIcon FontSize="{StaticResource IconFontSize}" Glyph="&#xE73F;" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
