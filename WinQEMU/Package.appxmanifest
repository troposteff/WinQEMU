<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  IgnorableNamespaces="uap rescap uap5 desktop4">

  <Identity
    Name="cfde84db-a7f2-4241-ae31-4fd9bc34967b"
    Publisher="CN=troposteff"
    Version="2026.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="cfde84db-a7f2-4241-ae31-4fd9bc34967b" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>WinQEMU</DisplayName>
    <PublisherDisplayName>troposteff</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <!-- SupportsMultipleInstances for the winqemu alias below: Windows refuses a console alias without it (0x80080204).
         It does not make WinQEMU run twice: Program.Main hands a second start over to the running one (AppInstance). -->
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$"
      desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="WinQEMU"
        Description="WinQEMU"
        BackgroundColor="#0B0D12"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- WinQEMU at the Windows logon, off until asked for in its settings (StartupTask); listed in
             Windows' own startup apps too, where it can be turned off. -->
        <uap5:Extension
          Category="windows.startupTask"
          Executable="WinQEMU.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="WinQEMUStartup" Enabled="false" DisplayName="WinQEMU" />
        </uap5:Extension>
        <!-- The winqemu command in any terminal: WinQEMU.Cli, a console program that drives the running WinQEMU. Its own
             executable on WinQEMU's application rather than an application of its own hidden from the Start menu: the
             Microsoft Store refuses such a "headless" application. A console subsystem, or
             the terminal would not wait for it nor show what it prints. -->
        <uap5:Extension
          Category="windows.appExecutionAlias"
          Executable="WinQEMU.Cli.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="winqemu.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- For machines given the microphone: QEMU is started by this package and runs as part of it, so the
         microphone is asked for in its name. -->
    <DeviceCapability Name="microphone"/>
  </Capabilities>
</Package>
