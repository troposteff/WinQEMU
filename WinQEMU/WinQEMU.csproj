<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinQEMU</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinQEMU.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- The Windows App SDK inside the package rather than a framework package to install first: a PC needs nothing
         but QEMU (tools/Build-Package.ps1). -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Program.Main instead: one WinQEMU at a time. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Globbed rather than listed: the icon set has a file per scale and per target size, and an
         asset missing from this list is silently absent from the package. -->
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\WinQEMU.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- TAP-Windows driver installer (OpenVPN, GPLv2), run by WinQEMU for internal networks: see Assets\Drivers\README.txt. -->
    <Content Include="Assets\Drivers\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1721" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinQEMU.Core\WinQEMU.Core.csproj" />
    <!-- The winqemu command: its exe, runtimeconfig and deps are copied next to WinQEMU.exe (alias in the manifest). -->
    <ProjectReference Include="..\WinQEMU.Cli\WinQEMU.Cli.csproj" />
  </ItemGroup>

  <!-- Interface text, as in WinQEMU.Core: English in Text\X.resx, French in Text\X.fr.resx, a class per English
       file. XAML reads it by x:Bind to the class's static properties ({x:Bind t:WindowText.Start}), so a key
       misspelled in XAML does not build either. -->
  <PropertyGroup>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Update="Text\WindowText.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="WinQEMU.Text" StronglyTypedClassName="WindowText" StronglyTypedFileName="$(IntermediateOutputPath)WindowText.g.cs" />
    <EmbeddedResource Update="Text\ShellText.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="WinQEMU.Text" StronglyTypedClassName="ShellText" StronglyTypedFileName="$(IntermediateOutputPath)ShellText.g.cs" />
    <EmbeddedResource Update="Text\DialogText.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="WinQEMU.Text" StronglyTypedClassName="DialogText" StronglyTypedFileName="$(IntermediateOutputPath)DialogText.g.cs" />
    <EmbeddedResource Update="Text\LibraryText.resx" StronglyTypedLanguage="CSharp" StronglyTypedNamespace="WinQEMU.Text" StronglyTypedClassName="LibraryText" StronglyTypedFileName="$(IntermediateOutputPath)LibraryText.g.cs" />
  </ItemGroup>
  <!-- The XAML compiler runs its passes at the start of PrepareResources, before ResGen writes these classes:
       XAML that binds to them then failed in pass 2, exit code 1 and no message at all. -->
  <Target Name="GenerateTextBeforeXaml" BeforeTargets="MarkupCompilePass1" DependsOnTargets="PrepareResourceNames;ResGen" />

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Never trimmed: {Binding}, the settings' JSON and the descriptors are read by reflection, which trimming breaks. -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>